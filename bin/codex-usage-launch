#!/usr/bin/env bash
set -u

terminal_bin=${GNOME_TERMINAL_BIN:-}
terminal_server_bin=${GNOME_TERMINAL_SERVER_BIN:-/usr/libexec/gnome-terminal-server}
terminal_client_bin=${GNOME_TERMINAL_CLIENT_BIN:-/usr/bin/gnome-terminal.real}
busctl_bin=${CODEX_STATUS_BUSCTL_BIN:-/usr/bin/busctl}
status_bin=${CODEX_USAGE_WATCH_BIN:-"$HOME/.local/bin/codex-usage-watch"}
profile=${CODEX_STATUS_TERMINAL_PROFILE:-Codex-status}
log_file=${CODEX_STATUS_LAUNCH_LOG:-"${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher/status-launch.log"}
status_runtime_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}/codex-account-switcher
retry_delay=${CODEX_STATUS_LAUNCH_RETRY_DELAY:-0.5}
ready_checks=${CODEX_STATUS_READY_CHECKS:-50}
ready_poll_delay=${CODEX_STATUS_READY_POLL_DELAY:-0.1}

mkdir -p "$(dirname -- "$log_file")"
chmod 700 "$(dirname -- "$log_file")"
mkdir -p "$status_runtime_dir"
chmod 700 "$status_runtime_dir"
if [[ -f $log_file ]] && (( $(stat -c %s "$log_file" 2>/dev/null || printf 0) > 65536 )); then
  tail -n 100 "$log_file" >"${log_file}.tmp"
  mv -f "${log_file}.tmp" "$log_file"
fi

if [[ ! -x $status_bin ]] || {
  [[ -n $terminal_bin ]] && [[ ! -x $terminal_bin ]]
} || {
  [[ -z $terminal_bin ]] && { [[ ! -x $terminal_server_bin || ! -x $terminal_client_bin || ! -x $busctl_bin ]]; }
}; then
  printf '%s launcher preflight failed: status or terminal binary missing\n' \
    "$(date --iso-8601=seconds)" >>"$log_file"
  notify-send 'Codex-kontostatus kunde inte starta' \
    "Kontrollera installationen. Diagnostik: $log_file" 2>/dev/null || true
  exit 78
fi

printf '%s launcher invoked pid=%s\n' "$(date --iso-8601=seconds)" "$BASHPID" >>"$log_file"

server_pid=''
client_pid=''
ready_file=''
cleanup() {
  if [[ -n $client_pid ]]; then
    kill "$client_pid" 2>/dev/null || true
    wait "$client_pid" 2>/dev/null || true
  fi
  if [[ -n $server_pid ]]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  [[ -z $ready_file ]] || rm -f -- "$ready_file"
}
trap cleanup EXIT

wait_for_status_ready() {
  local process_pid=$1
  local check
  for ((check = 0; check < ready_checks; check++)); do
    [[ -e $ready_file ]] && return 0
    kill -0 "$process_pid" 2>/dev/null || break
    sleep "$ready_poll_delay"
  done
  [[ -e $ready_file ]]
}

for attempt in 1 2; do
  started_at=$SECONDS
  ready_file=$(mktemp "$status_runtime_dir/status-launch-ready.XXXXXX")
  rm -f -- "$ready_file"
  start_verified=false
  # Mint's Python wrapper can return success without starting the terminal.
  # Keep WM_CLASS stable but give each explicit server its own D-Bus name.
  app_id="com.canonical.Terminal.CodexStatus.instance${BASHPID}${attempt}"
  if [[ -n $terminal_bin ]]; then
    CODEX_STATUS_READY_FILE="$ready_file" "$terminal_bin" --wait --hide-menubar --app-id="$app_id" --class=CodexStatus --role=codex-status --profile="$profile" -- "$status_bin" 2>>"$log_file" &
    client_pid=$!
    if wait_for_status_ready "$client_pid"; then
      start_verified=true
    else
      kill "$client_pid" 2>/dev/null || true
    fi
    wait "$client_pid"
    status=$?
    client_pid=''
  else
    "$terminal_server_bin" --app-id "$app_id" --class CodexStatus >/dev/null 2>>"$log_file" &
    server_pid=$!
    ready=false
    for ((check = 0; check < 50; check++)); do
      if "$busctl_bin" --user status "$app_id" >/dev/null 2>&1; then
        ready=true
        break
      fi
      kill -0 "$server_pid" 2>/dev/null || break
      sleep 0.1
    done
    if [[ $ready == true ]]; then
      CODEX_STATUS_READY_FILE="$ready_file" "$terminal_client_bin" --app-id "$app_id" --wait --hide-menubar --role=codex-status --profile="$profile" -- "$status_bin" 2>>"$log_file" &
      client_pid=$!
      if wait_for_status_ready "$client_pid"; then
        start_verified=true
      else
        kill "$client_pid" 2>/dev/null || true
      fi
      wait "$client_pid"
      status=$?
      client_pid=''
    else
      printf '%s terminal server did not become ready\n' "$(date --iso-8601=seconds)" >>"$log_file"
      status=70
    fi
    cleanup
    server_pid=''
  fi
  elapsed=$((SECONDS - started_at))
  if [[ $start_verified == false ]] && ((status == 0)); then
    status=70
  fi
  printf '%s terminal returned exit=%d elapsed=%ds attempt=%d\n' \
    "$(date --iso-8601=seconds)" "$status" "$elapsed" "$attempt" >>"$log_file"

  # Once the status process has rendered and signalled readiness, every later
  # exit belongs to the window lifecycle rather than terminal startup.
  if [[ $start_verified == true ]]; then
    printf '%s status startup verified; later window exit is not a launch failure\n' \
      "$(date --iso-8601=seconds)" >>"$log_file"
    exit "$status"
  fi
  rm -f -- "$ready_file"
  ready_file=''
  if ((attempt == 2)); then
    printf '%s terminal child failed: exit=%d elapsed=%ds attempt=%d\n' \
      "$(date --iso-8601=seconds)" "$status" "$elapsed" "$attempt" >>"$log_file"
    notify-send 'Codex-kontostatus kunde inte starta' \
      "Terminalstarten misslyckades. Diagnostik: $log_file" 2>/dev/null || true
    exit "$status"
  fi

  printf '%s transient terminal child failure: exit=%d elapsed=%ds; retrying once\n' \
    "$(date --iso-8601=seconds)" "$status" "$elapsed" >>"$log_file"
  sleep "$retry_delay"
done

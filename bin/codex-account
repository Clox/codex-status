#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_file="$config_home/codex-account-switcher/accounts.conf"

if [[ ! -r $config_file ]]; then
  printf 'Missing configuration: %s\nRun the repository installer first.\n' "$config_file" >&2
  exit 78
fi

# This file is created locally with mode 0600. It must never be committed.
# shellcheck source=/dev/null
source "$config_file"

export CODEX_HOME
export PATH="$NODE_BIN_DIR:${PATH:-/usr/local/bin:/usr/bin:/bin}"
ACCOUNT_STATE_CHECKER=${ACCOUNT_STATE_CHECKER:-"$HOME/.local/bin/codex-account-state"}
operation_lock_dir=${CODEX_OPERATION_LOCK_DIR:-"${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher/exclusive-codex-operation.lock"}

acquire_operation_lock() {
  mkdir -p "$(dirname -- "$operation_lock_dir")"
  chmod 700 "$(dirname -- "$operation_lock_dir")"
  if ! mkdir -m 700 "$operation_lock_dir" 2>/dev/null; then
    owner=''
    [[ -r "$operation_lock_dir/owner" ]] && read -r owner <"$operation_lock_dir/owner"
    if [[ $owner =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then
      printf 'En annan exklusiv Codex-operation pågår. Kontobytet avbröts.\n' >&2
      exit 75
    fi
    rm -f -- "$operation_lock_dir/owner"
    rmdir -- "$operation_lock_dir" 2>/dev/null || {
      printf 'Codex operationslåset kunde inte återställas säkert.\n' >&2
      exit 75
    }
    mkdir -m 700 "$operation_lock_dir"
  fi
  printf '%s\n' "$BASHPID" >"$operation_lock_dir/owner"
  trap 'rm -f -- "$operation_lock_dir/owner"; rmdir -- "$operation_lock_dir" 2>/dev/null || true' EXIT
}

release_operation_lock() {
  rm -f -- "$operation_lock_dir/owner"
  rmdir -- "$operation_lock_dir" 2>/dev/null || true
  trap - EXIT
}

usage() {
  printf 'Usage: codex-account <1|2|3> [--desktop] [desktop arguments...]\n' >&2
  exit 64
}

[[ $# -ge 1 ]] || usage
acquire_operation_lock
account_number=$1
case "$account_number" in
  1) account_selector=${ACCOUNT_1:?ACCOUNT_1 is not configured} ;;
  2) account_selector=${ACCOUNT_2:?ACCOUNT_2 is not configured} ;;
  3) account_selector=${ACCOUNT_3:?ACCOUNT_3 is not configured} ;;
  *) usage ;;
esac
shift

expected_state=$("$ACCOUNT_STATE_CHECKER" resolve "$CODEX_HOME" "$account_selector") || {
  message='Kunde inte entydigt koppla launchern till sparad account-state. Kontobytet avbröts.'
  notify-send 'Codex-kontobyte stoppat' "$message" 2>/dev/null || true
  printf '%s\n' "$message" >&2
  exit 3
}
IFS=$'\t' read -r expected_account_id expected_account_key <<<"$expected_state"
[[ -n $expected_account_id && -n $expected_account_key ]] || usage

launch_desktop=false
if [[ ${1:-} == '--desktop' ]]; then
  launch_desktop=true
  shift
fi

desktop_running() {
  pgrep -x ChatGPT >/dev/null 2>&1 ||
    pgrep -f "^${CHATGPT_BINARY_PATTERN}( |$)" >/dev/null 2>&1
}

if [[ $launch_desktop == true ]] && desktop_running; then
  notify-send 'Codex-kontobyte' 'Avslutar Codex Desktop innan kontobytet.' 2>/dev/null || true
  pkill -TERM -x ChatGPT >/dev/null 2>&1 || true
  if desktop_running; then
    pkill -TERM -f "^${CHATGPT_BINARY_PATTERN}( |$)" >/dev/null 2>&1 || true
  fi

  for ((attempt = 0; attempt < 75; attempt++)); do
    desktop_running || break
    sleep 0.2
  done

  if desktop_running; then
    message='Codex Desktop stängdes inte inom 15 sekunder. Kontobytet avbröts; avsluta appen manuellt och försök igen.'
    notify-send 'Codex-kontobyte stoppat' "$message" 2>/dev/null || true
    printf '%s\n' "$message" >&2
    exit 2
  fi
fi

if ! "$CODEX_AUTH_BIN" switch "$account_selector"; then
  message='codex-auth kunde inte byta konto. Kör codex-auth list i en terminal för detaljer.'
  notify-send 'Codex-kontobyte misslyckades' "$message" 2>/dev/null || true
  printf '%s\n' "$message" >&2
  exit 1
fi

if ! "$ACCOUNT_STATE_CHECKER" verify "$CODEX_HOME" "$expected_account_id" "$expected_account_key"; then
  message='Kontobytets postcondition misslyckades: global auth och aktiv registry-post överensstämmer inte. Desktop startas inte.'
  notify-send 'Codex-kontobyte stoppat' "$message" 2>/dev/null || true
  printf '%s\n' "$message" >&2
  exit 3
fi

if [[ $launch_desktop == true ]]; then
  notify-send 'Codex-konto valt' 'Startar Codex Desktop med det valda kontot.' 2>/dev/null || true
  release_operation_lock
  exec "$CHATGPT_LAUNCHER" "$@"
fi

printf 'Konto %s är nu valt. Starta om Codex Desktop eller kör "Developer: Reload Window" i VS Code.\n' "$account_number"

#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_file="$config_home/codex-account-switcher/accounts.conf"

if [[ ! -r $config_file ]]; then
  printf 'Missing configuration: %s\nRun the repository installer first.\n' "$config_file" >&2
  exit 78
fi

# This file is created locally with mode 0600. It must never be committed.
# shellcheck source=/dev/null
source "$config_file"

export CODEX_HOME
export PATH="$NODE_BIN_DIR:${PATH:-/usr/local/bin:/usr/bin:/bin}"
ACCOUNT_STATE_CHECKER=${ACCOUNT_STATE_CHECKER:-"$HOME/.local/bin/codex-account-state"}
ACCOUNT_SWITCH_CORE=${ACCOUNT_SWITCH_CORE:-"$(dirname -- "$0")/codex-account-switch-core"}
CONTINUATION_DRAFTS=${CONTINUATION_DRAFTS:-"$HOME/.local/bin/codex-continuation-drafts"}
USAGE_REFRESHER=${USAGE_REFRESHER:-"$HOME/.local/bin/codex-usage-refresh"}
operation_lock_dir=${CODEX_OPERATION_LOCK_DIR:-"${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher/exclusive-codex-operation.lock"}
operation_lock_helper="$(dirname -- "$0")/../lib/codex-operation-lock.js"
operation_lock_generation=''
continuation_plan=''

cleanup_operation() {
  if [[ -n $operation_lock_generation ]]; then
    node "$operation_lock_helper" release "$operation_lock_dir" "$BASHPID" "$operation_lock_generation"
    operation_lock_generation=''
  fi
  [[ -z $continuation_plan ]] || rm -f -- "$continuation_plan"
}

acquire_operation_lock() {
  operation_lock_generation=$(node "$operation_lock_helper" acquire "$operation_lock_dir" "$BASHPID") || {
    printf 'En annan exklusiv Codex-operation pågår. Kontobytet avbröts.\n' >&2
    exit 75
  }
  trap cleanup_operation EXIT
}

release_operation_lock() {
  cleanup_operation
  trap - EXIT
}

usage() {
  printf 'Usage: codex-account <1|2|3|--key BASE64URL> [--desktop] [desktop arguments...]\n' >&2
  exit 64
}

[[ $# -ge 1 ]] || usage
acquire_operation_lock
account_number=$1
case "$account_number" in
  --key)
    [[ ${2:-} =~ ^[A-Za-z0-9_-]+$ ]] || usage
    account_selector=$(node -e 'process.stdout.write(Buffer.from(process.argv[1], "base64url").toString("utf8"))' "$2")
    [[ -n $account_selector ]] || usage
    shift
    ;;
  1) account_selector=${ACCOUNT_1:?ACCOUNT_1 is not configured} ;;
  2) account_selector=${ACCOUNT_2:?ACCOUNT_2 is not configured} ;;
  3) account_selector=${ACCOUNT_3:?ACCOUNT_3 is not configured} ;;
  *) usage ;;
esac
shift

resolve_mode=resolve
[[ $account_number != --key ]] || resolve_mode=resolve-key
expected_state=$("$ACCOUNT_STATE_CHECKER" "$resolve_mode" "$CODEX_HOME" "$account_selector") || {
  message='Kunde inte entydigt koppla launchern till sparad account-state. Kontobytet avbröts.'
  notify-send 'Codex-kontobyte stoppat' "$message" 2>/dev/null || true
  printf '%s\n' "$message" >&2
  exit 3
}
IFS=$'\t' read -r expected_account_id expected_account_key upstream_selector <<<"$expected_state"
[[ -n $expected_account_id && -n $expected_account_key ]] || usage

launch_desktop=false
if [[ ${1:-} == '--desktop' ]]; then
  launch_desktop=true
  shift
fi

continuation_action='none'
if [[ $launch_desktop == true && -x $CONTINUATION_DRAFTS ]]; then
  source_state=$("$ACCOUNT_STATE_CHECKER" active "$CODEX_HOME" 2>/dev/null || true)
  IFS=$'\t' read -r source_account_id source_account_key <<<"$source_state"
  if [[ -n ${source_account_id:-} && -n ${source_account_key:-} ]]; then
    continuation_dir=${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher
    mkdir -p "$continuation_dir"
    chmod 700 "$continuation_dir"
    continuation_plan=$(mktemp "$continuation_dir/continuation-plan.XXXXXX")
    chmod 600 "$continuation_plan"
    continuation_result=$("$CONTINUATION_DRAFTS" prepare "$continuation_plan" \
      "$source_account_id" "$source_account_key" "$expected_account_id" "$expected_account_key" 2>/dev/null || true)
    continuation_action=${continuation_result%%:*}
    if [[ $continuation_action == blocked ]]; then
      notify-send 'Continuation-utkast hoppades över' \
        'Observer- eller usage-state kunde inte verifieras före kontobytet. Inget draft injiceras.' 2>/dev/null || true
    fi
  fi
fi

desktop_running() {
  pgrep -x ChatGPT >/dev/null 2>&1 ||
    pgrep -f "^${CHATGPT_BINARY_PATTERN}( |$)" >/dev/null 2>&1
}

if [[ $launch_desktop == true ]] && desktop_running; then
  notify-send 'Codex-kontobyte' 'Avslutar Codex Desktop innan kontobytet.' 2>/dev/null || true
  pkill -TERM -x ChatGPT >/dev/null 2>&1 || true
  if desktop_running; then
    pkill -TERM -f "^${CHATGPT_BINARY_PATTERN}( |$)" >/dev/null 2>&1 || true
  fi

  for ((attempt = 0; attempt < 75; attempt++)); do
    desktop_running || break
    sleep 0.2
  done

  if desktop_running; then
    message='Codex Desktop stängdes inte inom 15 sekunder. Kontobytet avbröts; avsluta appen manuellt och försök igen.'
    notify-send 'Codex-kontobyte stoppat' "$message" 2>/dev/null || true
    printf '%s\n' "$message" >&2
    exit 2
  fi
fi

if ! CODEX_AUTH_BIN="$CODEX_AUTH_BIN" "$ACCOUNT_SWITCH_CORE" "$CODEX_HOME" "$expected_account_key"; then
  message='Kontobytet eller dess auth-verifiering misslyckades. Desktop startas inte.'
  notify-send 'Codex-kontobyte stoppat' "$message" 2>/dev/null || true
  printf '%s\n' "$message" >&2
  exit 3
fi

if [[ $launch_desktop == true ]]; then
  notify-send 'Codex-konto valt' 'Startar Codex Desktop med det valda kontot.' 2>/dev/null || true
  USAGE_REFRESH_INTERVAL_MS=0 "$USAGE_REFRESHER" >/dev/null 2>&1 || true
  setsid -f "$CHATGPT_LAUNCHER" "$@" </dev/null >/dev/null 2>&1
  for ((attempt = 0; attempt < 75; attempt++)); do
    desktop_running && break
    sleep 0.2
  done
  if ! desktop_running; then
    message='Codex Desktop startade inte inom 15 sekunder efter det verifierade kontobytet.'
    notify-send 'Codex Desktop kunde inte starta' "$message" 2>/dev/null || true
    printf '%s\n' "$message" >&2
    exit 4
  fi
  if [[ $continuation_action == prefill ]]; then
    if ! "$CONTINUATION_DRAFTS" apply "$continuation_plan" >/dev/null 2>&1; then
      notify-send 'Continuation-utkast hoppades över' \
        'Efterkontrollen var osäker eller en deep-link misslyckades. Ingen automatisk Send har gjorts.' 2>/dev/null || true
    fi
  fi
  release_operation_lock
  exit 0
fi

printf 'Kontot är nu valt. Starta om Codex Desktop eller kör "Developer: Reload Window" i VS Code.\n'

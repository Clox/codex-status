#!/usr/bin/env node

'use strict';

const childProcess = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const {
  buildContinuationPlan,
  continuationDeepLinks,
  validateContinuationPlan,
} = require(path.join(__dirname, '..', 'lib', 'codex-continuation-drafts'));
const { normalizeResumeState } = require(path.join(__dirname, '..', 'lib', 'codex-manual-resume'));
const { normalizeState } = require(path.join(__dirname, '..', 'lib', 'codex-turn-observer'));
const { verifyActiveAccountState } = require(path.join(__dirname, '..', 'lib', 'codex-account-state'));
const { defaultStatusPreferencesPath, readStatusPreferences } = require(path.join(__dirname, '..', 'lib', 'codex-status-preferences'));
const { OWNER, candidateIdentity } = require(path.join(__dirname, '..', 'lib', 'codex-continuation-ownership'));

const codexHome = process.env.CODEX_HOME || path.join(os.homedir(), '.codex');
const cacheHome = process.env.XDG_CACHE_HOME || path.join(os.homedir(), '.cache');
const eventStatePath = process.env.CODEX_EVENT_STATE || path.join(cacheHome, 'codex-account-switcher', 'turn-events.json');
const resumeStatePath = process.env.CODEX_RESUME_STATE || path.join(cacheHome, 'codex-account-switcher', 'manual-resume.json');
const usageCachePath = process.env.USAGE_CACHE || path.join(cacheHome, 'codex-account-switcher', 'usage.json');
const desktopBinary = process.env.CHATGPT_BINARY_PATTERN || '/usr/lib/chatgpt/ChatGPT';
const preferencesPath = process.env.CODEX_STATUS_PREFERENCES || defaultStatusPreferencesPath();
const draftJournalPath = process.env.CODEX_DRAFT_JOURNAL || path.join(cacheHome, 'codex-account-switcher', 'continuation-drafts.json');

function fail(message, code = 3) {
  process.stderr.write(`${message}\n`);
  process.exit(code);
}

function readJson(filename, fallback) {
  try {
    return JSON.parse(fs.readFileSync(filename, 'utf8'));
  } catch (error) {
    if (fallback !== undefined && error.code === 'ENOENT') return fallback;
    throw error;
  }
}

function atomicWriteJson(filename, value) {
  fs.mkdirSync(path.dirname(filename), { recursive: true, mode: 0o700 });
  fs.chmodSync(path.dirname(filename), 0o700);
  const temporary = `${filename}.tmp-${process.pid}`;
  fs.writeFileSync(temporary, `${JSON.stringify(value, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporary, filename);
  fs.chmodSync(filename, 0o600);
}

function stateSnapshot() {
  return {
    eventState: normalizeState(readJson(eventStatePath)),
    resumeState: normalizeResumeState(readJson(resumeStatePath, {})),
    usageCache: readJson(usageCachePath),
    preferences: readStatusPreferences(preferencesPath),
  };
}

function journalCandidate(candidate, phase, result) {
  const previous = readJson(draftJournalPath, { version: 1, events: [], claims: {} });
  const events = Array.isArray(previous.events) ? previous.events.slice(-199) : [];
  const claims = previous.claims && typeof previous.claims === 'object' ? previous.claims : {};
  if (phase === 'apply' && (result === 'dispatch-attempted' || result === 'dispatched')) {
    claims[candidateIdentity(candidate)] = { threadId: candidate.threadId, failedTurnId: candidate.turnId,
      owner: OWNER.MANUAL_DRAFT, claimedAtMs: claims[candidateIdentity(candidate)]?.claimedAtMs || Date.now(),
      status: result };
  }
  events.push({ atMs: Date.now(), phase, threadId: candidate.threadId, failedTurnId: candidate.turnId,
    owner: candidate.owner, mode: candidate.mode, eligible: candidate.owner === OWNER.MANUAL_DRAFT &&
      candidate.mode !== 'skip', result });
  atomicWriteJson(draftJournalPath, { version: 1, events, claims });
}

function prepare(args) {
  const [planPath, sourceAccountId, sourceAccountKey, targetAccountId, targetAccountKey] = args;
  if (!planPath || !sourceAccountId || !sourceAccountKey || !targetAccountId || !targetAccountKey) {
    fail('Usage: codex-continuation-drafts prepare <plan-file> <source-id> <source-key> <target-id> <target-key>', 64);
  }
  const state = stateSnapshot();
  const plan = buildContinuationPlan({
    sourceAccountId,
    sourceAccountKey,
    targetAccountId,
    targetAccountKey,
    ...state,
  });
  atomicWriteJson(planPath, plan);
  for (const candidate of plan.candidates) journalCandidate(candidate, 'prepare',
    candidate.mode === 'skip' ? 'skipped' : 'eligible');
  process.stdout.write(`${plan.action}${plan.reason ? `:${plan.reason}` : ''}\n`);
}

function verifiedActiveTarget(plan) {
  const registry = readJson(path.join(codexHome, 'accounts', 'registry.json'));
  const globalAuth = readJson(path.join(codexHome, 'auth.json'));
  const result = verifyActiveAccountState({
    registry,
    globalAuth,
    expectedAccountId: plan.targetAccountId,
    expectedAccountKey: plan.targetAccountKey,
  });
  return {
    ok: result.ok,
    accountId: globalAuth?.tokens?.account_id || null,
    accountKey: registry?.active_account_key || null,
    errors: result.errors,
  };
}

function apply(args) {
  const [planPath] = args;
  if (!planPath) fail('Usage: codex-continuation-drafts apply <plan-file>', 64);
  const plan = readJson(planPath);
  if (plan.action !== 'prefill') {
    for (const candidate of plan.candidates || []) journalCandidate(candidate, 'apply', 'skipped');
    process.stdout.write('skipped\n');
    return;
  }
  const active = verifiedActiveTarget(plan);
  if (!active.ok) {
    for (const candidate of plan.candidates) journalCandidate(candidate, 'apply', 'target-auth-unverified');
    fail(`CONTINUATION_DRAFT_BLOCKED:target-auth-unverified:${active.errors.join(',')}`);
  }
  const validation = validateContinuationPlan({
    plan,
    ...stateSnapshot(),
    activeAccountId: active.accountId,
    activeAccountKey: active.accountKey,
  });
  if (!validation.ok) {
    for (const candidate of plan.candidates) journalCandidate(candidate, 'apply', `skipped:${validation.reason}`);
    fail(`CONTINUATION_DRAFT_BLOCKED:${validation.reason}`);
  }

  const candidates = validation.candidates.filter(candidate => candidate.owner === OWNER.MANUAL_DRAFT &&
    candidate.mode !== 'skip');
  for (const candidate of validation.candidates.filter(candidate => candidate.mode === 'skip')) {
    journalCandidate(candidate, 'apply', 'skipped');
  }
  for (const candidate of candidates) {
    // AUTO mode may change while several deep links are being dispatched.
    if (readStatusPreferences(preferencesPath).autoMode !== 'OFF') {
      journalCandidate(candidate, 'apply', 'skipped:ownership-changed');
      fail('CONTINUATION_DRAFT_BLOCKED:ownership-changed');
    }
    const [link] = continuationDeepLinks([candidate]);
    journalCandidate(candidate, 'apply', 'dispatch-attempted');
    const result = childProcess.spawnSync(desktopBinary, [link], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'pipe'],
      timeout: 15_000,
    });
    if (result.error || result.status !== 0) {
      journalCandidate(candidate, 'apply', 'dispatch-failed');
      fail(`CONTINUATION_DRAFT_DEEPLINK_FAILED:${result.error?.code || result.status || 'unknown'}`);
    }
    journalCandidate(candidate, 'apply', 'dispatched');
  }
  process.stdout.write(`prefilled:${candidates.length}\n`);
}

try {
  const [command, ...args] = process.argv.slice(2);
  if (command === 'prepare') prepare(args);
  else if (command === 'apply') apply(args);
  else fail('Usage: codex-continuation-drafts <prepare|apply> ...', 64);
} catch (error) {
  fail(`CONTINUATION_DRAFT_FAILED:${error.message}`);
}

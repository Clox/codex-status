#!/usr/bin/env node
'use strict';

const path = require('node:path');
const { runAccountSwitch } = require(path.join(__dirname, '..', 'lib', 'codex-account-switch-core'));

const [codexHome, targetAccountKey] = process.argv.slice(2);
if (!codexHome || !targetAccountKey) {
  process.stderr.write('Usage: codex-account-switch-core <CODEX_HOME> <account-key>\n');
  process.exit(64);
}
async function main() {
  if (process.argv[4] === '--pool') {
    const { locations, readRegistry, instanceById } = require('../lib/codex-instances');
    const { provisionAccount } = require('../lib/codex-account-pool');
    const loc = locations();
    const primary = instanceById(readRegistry(loc), 'default');
    if (codexHome !== primary.codexHome) throw new Error('INSTANCE_HOME_UNVERIFIED');
    return provisionAccount('default', targetAccountKey, loc, process.env,
      { authBin: process.env.CODEX_AUTH_BIN || 'codex-auth' });
  }
  runAccountSwitch({ codexHome, targetAccountKey, authBin: process.env.CODEX_AUTH_BIN || 'codex-auth',
    source: 'manual' });
}
main().catch(error => {
  process.stderr.write(`Account switch failed: ${error.message}\n`);
  process.exitCode = 3;
});

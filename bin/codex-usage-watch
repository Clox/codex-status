#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_file="$config_home/codex-account-switcher/accounts.conf"
if [[ ! -r $config_file ]]; then
  printf 'Missing configuration: %s\nRun the repository installer first.\n' "$config_file" >&2
  exit 78
fi
# shellcheck source=/dev/null
source "$config_file"

export CODEX_HOME
export ACCOUNT_1 ACCOUNT_2 ACCOUNT_3
export PATH="$NODE_BIN_DIR:${PATH:-/usr/local/bin:/usr/bin:/bin}"
export RESET_CREDITS_CACHE
USAGE_REFRESHER=${USAGE_REFRESHER:-"$HOME/.local/bin/codex-usage-refresh"}
USAGE_CACHE=${USAGE_CACHE:-"${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher/usage.json"}
AUTH_REPAIRER=${AUTH_REPAIRER:-"$HOME/.local/bin/codex-auth-repair"}
CODEX_LOGIN_BIN=${CODEX_LOGIN_BIN:-/usr/lib/chatgpt/resources/codex}
export ACCOUNT_SWITCHER
export CODEX_AUTH_BIN USAGE_REFRESHER USAGE_CACHE AUTH_REPAIRER CODEX_LOGIN_BIN
FIVE_HOUR_ACTIVATION_STATE=${FIVE_HOUR_ACTIVATION_STATE:-"${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher/five-hour-activation.json"}
export FIVE_HOUR_ACTIVATION_STATE
CODEX_EVENT_STATE=${CODEX_EVENT_STATE:-"${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher/turn-events.json"}
export CODEX_EVENT_STATE
CODEX_RESUME_STATE=${CODEX_RESUME_STATE:-"${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher/manual-resume.json"}
CODEX_MANUAL_RESUME=${CODEX_MANUAL_RESUME:-"$HOME/.local/bin/codex-manual-resume"}
CODEX_STATUS_PREFERENCES=${CODEX_STATUS_PREFERENCES:-"${XDG_CONFIG_HOME:-$HOME/.config}/codex-account-switcher/status-preferences.json"}
CODEX_STATUS_PREFERENCES_BIN=${CODEX_STATUS_PREFERENCES_BIN:-"$HOME/.local/bin/codex-status-preferences"}
CODEX_AUTO_CONTINUE_STATE=${CODEX_AUTO_CONTINUE_STATE:-"${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher/auto-continue.json"}
CODEX_QUOTA_TRANSITION_STATE=${CODEX_QUOTA_TRANSITION_STATE:-"${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher/quota-transition.json"}
CODEX_QUOTA_TRANSITION_BIN=${CODEX_QUOTA_TRANSITION_BIN:-"$HOME/.local/bin/codex-quota-transition"}
export CODEX_RESUME_STATE CODEX_MANUAL_RESUME CODEX_STATUS_PREFERENCES CODEX_STATUS_PREFERENCES_BIN
export CODEX_AUTO_CONTINUE_STATE
export CODEX_QUOTA_TRANSITION_STATE CODEX_QUOTA_TRANSITION_BIN
USAGE_REFRESH_LOG=${USAGE_REFRESH_LOG:-"${XDG_CACHE_HOME:-$HOME/.cache}/codex-account-switcher/usage-refresh.log"}
loaded_script_hash=$(sha256sum "$0" | awk '{ print $1 }')
printf '\033]0;Codex-kontostatus\007'

status_runtime_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}/codex-account-switcher
mkdir -p "$status_runtime_dir"
chmod 700 "$status_runtime_dir"
exec {status_lock_fd}>"$status_runtime_dir/status-window-v2.lock"
if ! flock -n "$status_lock_fd"; then
  printf '%s status singleton already held\n' "$(date --iso-8601=seconds)" >>"$status_runtime_dir/status-launch.log"
  if [[ ${CODEX_STATUS_READY_FILE:-} == "$status_runtime_dir"/status-launch-ready.* ]]; then
    : >"$CODEX_STATUS_READY_FILE"
    chmod 600 "$CODEX_STATUS_READY_FILE"
  fi
  exit 0
fi
status_started_at=$SECONDS
status_raw_frame_cache="$status_runtime_dir/status-raw-frame.txt"
collector_pid=''
collector_tmp=''

attention_fd=''
attention_pid=''
if [[ ${XDG_SESSION_TYPE:-} == x11 ]] && command -v wmctrl >/dev/null && command -v xprop >/dev/null; then
  coproc ATTENTION_CONTROLLER { "$HOME/.local/bin/codex-status-attention" >/dev/null 2>>"$status_runtime_dir/status-attention.log"; }
  # Bash may unset coproc descriptors before these assignments if the helper
  # exits immediately. Attention is optional; the status window must survive.
  attention_fd=${ATTENTION_CONTROLLER[1]-}
  attention_pid=${ATTENTION_CONTROLLER_PID-}
fi

saved_stty=''
cleanup() {
  local status=$1
  printf '%s status exited code=%d elapsed=%ds\n' \
    "$(date --iso-8601=seconds)" "$status" "$((SECONDS - status_started_at))" >>"$status_runtime_dir/status-launch.log"
  if [[ -n $attention_fd ]]; then
    exec {attention_fd}>&-
  fi
  if [[ -n $attention_pid ]]; then
    wait "$attention_pid" 2>/dev/null || true
  fi
  if [[ -n $collector_pid ]] && kill -0 "$collector_pid" 2>/dev/null; then
    kill "$collector_pid" 2>/dev/null || true
    wait "$collector_pid" 2>/dev/null || true
  fi
  [[ -z $collector_tmp ]] || rm -f -- "$collector_tmp"
  if [[ -n $saved_stty ]]; then
    stty "$saved_stty" </dev/tty 2>/dev/null || true
    tput smam 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    tput rmcup 2>/dev/null || true
  fi
}
trap 'cleanup "$?"' EXIT

if [[ -t 0 && -t 1 ]]; then
  saved_stty=$(stty -g </dev/tty)
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  stty -echo </dev/tty
  tput smcup
  tput civis
fi

pending_source_row=''
pending_since=0
pending_spinner_index=0
pending_spinner_frames=('WAIT/' 'WAIT─' 'WAIT\' 'WAIT|')
key_map=''
last_background_refresh=-10
paused_rendering=0
last_drawn_frame=''
base_frame=''
raw_frame=''
attention_json='{"worthy":false,"observationKey":null}'
active_source_row=''
ui_tick=0
collector_tick=0
last_columns=''
force_render=0

launch_detached() {
  setsid -f "$@" {status_lock_fd}>&- </dev/null >/dev/null 2>&1
}

launch_usage_refresh() {
  mkdir -p "$(dirname -- "$USAGE_REFRESH_LOG")"
  chmod 700 "$(dirname -- "$USAGE_REFRESH_LOG")"
  if [[ -f $USAGE_REFRESH_LOG ]] && (( $(stat -c %s "$USAGE_REFRESH_LOG" 2>/dev/null || printf 0) > 65536 )); then
    tail -n 100 "$USAGE_REFRESH_LOG" >"${USAGE_REFRESH_LOG}.tmp"
    mv -f "${USAGE_REFRESH_LOG}.tmp" "$USAGE_REFRESH_LOG"
  fi
  setsid -f "$USAGE_REFRESHER" {status_lock_fd}>&- </dev/null >>"$USAGE_REFRESH_LOG" 2>&1
}

draw_frame() {
  local frame_to_draw=$1
  tput rmam 2>/dev/null || printf '\033[?7l'
  tput cup 0 0 2>/dev/null || printf '\033[H'
  tput ed 2>/dev/null || printf '\033[J'
  printf '%s\n' "$frame_to_draw"
  if ((paused_rendering)); then
    printf '\033[1;33mPAUSED — tryck [P] för att återuppta och uppdatera vyn.\033[0m\n'
  fi
  printf '\n\033[2mPRIOR = weekly %% remaining per hour until reset × 100. Higher means more urgent.\033[0m\n'
  printf '\033[2mPress 1–9 for account, K to manage accounts, A for auto-continue or P to pause. Ctrl+C closes.\033[0m\n'
  tput ed 2>/dev/null || printf '\033[J'
  tput smam 2>/dev/null || printf '\033[?7h'
}

draw_current_frame() {
  local display_frame=$base_frame
  if [[ -n $pending_source_row ]]; then
    display_frame=${display_frame//WAIT\//${pending_spinner_frames[$pending_spinner_index]}}
  fi
  if ((!paused_rendering)) && [[ $display_frame != "$last_drawn_frame" ]]; then
    draw_frame "$display_frame"
    last_drawn_frame=$display_frame
  fi
}

signal_launcher_ready() {
  if [[ ${CODEX_STATUS_READY_FILE:-} == "$status_runtime_dir"/status-launch-ready.* ]]; then
    : >"$CODEX_STATUS_READY_FILE"
    chmod 600 "$CODEX_STATUS_READY_FILE"
  fi
}

start_local_collection() {
  [[ -z $collector_pid ]] || return 0
  collector_tmp=$(mktemp "$status_runtime_dir/status-raw-frame.XXXXXX")
  chmod 600 "$collector_tmp"
  (
    collection_lock="${CODEX_OPERATION_LOCK_DIR:-$status_runtime_dir/exclusive-codex-operation.lock}"
    mkdir -m 700 "$collection_lock" 2>/dev/null || { rm -f -- "$collector_tmp"; exit 1; }
    printf '%s\n' "$BASHPID" >"$collection_lock/owner"
    trap 'rm -f -- "$collection_lock/owner"; rmdir -- "$collection_lock" 2>/dev/null || true' EXIT
    if script -qefc "stty cols $columns; exec \"$CODEX_AUTH_BIN\" list --skip-api" /dev/null </dev/null >"$collector_tmp"; then
      mv -f -- "$collector_tmp" "$status_raw_frame_cache"
      chmod 600 "$status_raw_frame_cache"
    fi
  ) {status_lock_fd}>&- &
  collector_pid=$!
}

finish_local_collection() {
  [[ -n $collector_pid ]] || return 1
  kill -0 "$collector_pid" 2>/dev/null && return 1
  if wait "$collector_pid" && [[ -s $status_raw_frame_cache ]]; then
    raw_frame=$(<"$status_raw_frame_cache")
    force_render=1
  fi
  collector_pid=''
  collector_tmp=''
  return 0
}

process_snapshot() {
  status_now_ms=$(($(date +%s) * 1000))
  local frame key_map_next attention_next availability_json quota_transition
  if frame=$(
      printf '%s\n' "$raw_frame" |
        CODEX_STATUS_RANKING=1 CODEX_STATUS_COLUMNS="$columns" CODEX_PENDING_SOURCE_ROW="$pending_source_row" CODEX_PENDING_STATUS='WAIT/' CODEX_STATUS_NOW_MS="$status_now_ms" "$USAGE_ANNOTATOR"
    ) &&
    key_map_next=$(
      printf '%s\n' "$raw_frame" |
        CODEX_STATUS_RANKING=1 CODEX_STATUS_COLUMNS="$columns" CODEX_STATUS_NOW_MS="$status_now_ms" "$USAGE_ANNOTATOR" --switch-map
    ) &&
    attention_next=$(
      printf '%s\n' "$raw_frame" |
        CODEX_STATUS_RANKING=1 CODEX_STATUS_COLUMNS="$columns" CODEX_STATUS_NOW_MS="$status_now_ms" "$USAGE_ANNOTATOR" --attention-state
    ) &&
    availability_json=$(
      printf '%s\n' "$raw_frame" |
        CODEX_STATUS_RANKING=1 CODEX_STATUS_COLUMNS="$columns" CODEX_STATUS_NOW_MS="$status_now_ms" "$USAGE_ANNOTATOR" --availability-state
    ); then
    key_map=$key_map_next
    attention_json=$attention_next
    quota_transition=$(printf '%s\n' "$availability_json" | "$CODEX_QUOTA_TRANSITION_BIN" 2>>"$status_runtime_dir/status-launch.log") || quota_transition=null
    active_source_row=$(printf '%s\n' "$key_map" | awk '$3 == "active" { print $2; exit }')
    if [[ -n $pending_source_row && $pending_source_row == "$active_source_row" ]]; then
      pending_source_row=''
      pending_since=0
      pending_spinner_index=0
      frame=$(printf '%s\n' "$raw_frame" |
        CODEX_STATUS_RANKING=1 CODEX_STATUS_COLUMNS="$columns" CODEX_STATUS_NOW_MS="$status_now_ms" "$USAGE_ANNOTATOR")
    elif [[ -n $pending_source_row && $((SECONDS - pending_since)) -ge 2 ]] &&
        ! pgrep -f "^${ACCOUNT_SWITCHER} ([123]|--key [A-Za-z0-9_-]+) --desktop( |$)" >/dev/null 2>&1; then
      pending_source_row=''
      pending_since=0
      pending_spinner_index=0
      frame=$(printf '%s\n' "$raw_frame" |
        CODEX_STATUS_RANKING=1 CODEX_STATUS_COLUMNS="$columns" CODEX_STATUS_NOW_MS="$status_now_ms" "$USAGE_ANNOTATOR")
    fi
    recovery_fingerprint=$(printf '%s\n' "$quota_transition" | node -e '
      let input=""; process.stdin.on("data", chunk => input += chunk); process.stdin.on("end", () => {
        try { const event=JSON.parse(input); if (event?.type === "quota-available") process.stdout.write(event.fingerprint || ""); } catch {}
      });
    ')
    if [[ -n $recovery_fingerprint ]]; then
      recovery_labels=$(printf '%s\n' "$quota_transition" | node -e '
        let input=""; process.stdin.on("data", chunk => input += chunk); process.stdin.on("end", () => {
          try { const event=JSON.parse(input); process.stdout.write((event?.accounts || []).map(account => account.label).join(", ")); } catch {}
        });
      ')
      notify-send 'Codex-kvot åter tillgänglig' "Åter användbart: ${recovery_labels:-ett verifierat konto}." 2>/dev/null || true
      attention_json=$(printf '{"worthy":true,"immediate":true,"persistentUntilFocus":true,"fingerprint":"%s","situationClass":"quota-recovered","observationKey":"%s"}' "$recovery_fingerprint" "$recovery_fingerprint")
    fi
    base_frame=$frame
    if [[ -n $attention_fd ]]; then
      printf '%s\n' "$attention_json" >&"$attention_fd" 2>/dev/null || attention_fd=''
    fi
  elif [[ -n $attention_fd ]]; then
    printf '%s\n' '{"worthy":false,"observationKey":null}' >&"$attention_fd" 2>/dev/null || attention_fd=''
  fi
}

columns=$(tput cols 2>/dev/null || printf '100')
[[ $columns =~ ^[0-9]+$ ]] || columns=100
last_columns=$columns
if [[ -s $status_raw_frame_cache ]]; then
  raw_frame=$(<"$status_raw_frame_cache")
  process_snapshot
else
  base_frame=$'Codex-kontostatus\n\nLoading cached account state…'
fi
draw_current_frame
signal_launcher_ready
start_local_collection

while true; do
  ui_tick=$((ui_tick + 1))
  if ((ui_tick % 5 == 0)); then
    current_script_hash=$(sha256sum "$0" 2>/dev/null | awk '{ print $1 }')
    if [[ -z $current_script_hash || $current_script_hash != "$loaded_script_hash" ]]; then
      notify-send 'Codex-kontostatus uppdaterad' 'Statusfönstret stängs för att inte fortsätta med gammal kod. Öppna det igen.' 2>/dev/null || true
      printf '\nStatusverktyget har uppdaterats. Öppna Codex-kontostatus igen.\n'
      exit 75
    fi
    columns=$(tput cols 2>/dev/null || printf '100')
    [[ $columns =~ ^[0-9]+$ ]] || columns=100
    if [[ $columns != "$last_columns" ]]; then
      last_columns=$columns
      force_render=1
    fi
  fi

  if ((SECONDS - last_background_refresh >= 10)); then
    launch_usage_refresh
    "$RESET_CREDITS_REFRESHER" >/dev/null 2>&1 || true
    last_background_refresh=$SECONDS
  fi

  if finish_local_collection; then
    collector_tick=0
  else
    collector_tick=$((collector_tick + 1))
  fi
  if [[ -z $collector_pid ]] && ((collector_tick >= 10)); then
    start_local_collection
    collector_tick=0
  fi
  if ((force_render)) && [[ -n $raw_frame ]]; then
    process_snapshot
    force_render=0
  fi

  draw_current_frame
  if ((!paused_rendering)) && [[ -n $pending_source_row ]]; then
    pending_spinner_index=$(((pending_spinner_index + 1) % ${#pending_spinner_frames[@]}))
  fi

  key=''
  if IFS= read -rsn 1 -t 0.2 key </dev/tty; then
    case "$key" in
      1|2|3|4|5|6|7|8|9)
        if pgrep -f "^${ACCOUNT_SWITCHER} ([123]|--key [A-Za-z0-9_-]+) --desktop( |$)" >/dev/null 2>&1; then
          notify-send 'Codex-kontobyte pågår' 'Vänta tills det pågående kontobytet är klart.' 2>/dev/null || true
        else
          source_row=$(printf '%s\n' "$key_map" | awk -v rank="$key" '$1 == rank { print $2; exit }')
          launcher_account=$(printf '%s\n' "$key_map" | awk -v rank="$key" '$1 == rank { print $4; exit }')
          if [[ ! $source_row =~ ^[1-9][0-9]*$ ]]; then
            notify-send 'Codex-kontobyte stoppat' 'Kunde inte koppla rankingen till ett konto. Vänta på nästa uppdatering.' 2>/dev/null || true
            continue
          fi
          if [[ ! $launcher_account =~ ^[A-Za-z0-9_-]+$ || $launcher_account == - ]]; then
            notify-send 'Codex-kontobyte stoppat' 'Kunde inte entydigt identifiera kontot. Öppna kontomenyn med K.' 2>/dev/null || true
            continue
          fi
          if [[ $source_row == "$active_source_row" ]]; then
            launch_detached "$CHATGPT_LAUNCHER"
            continue
          fi
          pending_source_row=$source_row
          pending_since=$SECONDS
          pending_spinner_index=0
          base_frame=$(printf '%s\n' "$raw_frame" |
            CODEX_STATUS_RANKING=1 CODEX_STATUS_COLUMNS="$columns" CODEX_PENDING_SOURCE_ROW="$pending_source_row" CODEX_PENDING_STATUS='WAIT/' CODEX_STATUS_NOW_MS="$status_now_ms" "$USAGE_ANNOTATOR")
          if ((!paused_rendering)); then
            last_drawn_frame=''
            draw_current_frame
            pending_spinner_index=$(((pending_spinner_index + 1) % ${#pending_spinner_frames[@]}))
          fi
          launch_detached "$ACCOUNT_SWITCHER" --key "$launcher_account" --desktop
        fi
        ;;
      k|K)
        launch_detached "$(command -v gnome-terminal)" --hide-menubar --title='Codex-konton' -- "$HOME/.local/bin/codex-account-manager" --hold
        ;;
      r|R)
        if printf '%s\n' "$base_frame" | grep -Fq 'Press [R] to repair authentication'; then
          if pgrep -f "${AUTH_REPAIRER}([[:space:]]|$)" >/dev/null 2>&1; then
            notify-send 'Codex auth-reparation' 'En auth-reparation pågår redan.' 2>/dev/null || true
          else
            launch_detached "$(command -v gnome-terminal)" --hide-menubar --title='Codex auth-reparation' -- "$AUTH_REPAIRER" --hold
          fi
        else
          notify-send 'Codex auth-reparation' 'Inget konto har ett reparerbart authfel just nu.' 2>/dev/null || true
        fi
        ;;
      a|A)
        if ! "$CODEX_STATUS_PREFERENCES_BIN" toggle-auto-continue >/dev/null 2>>"$status_runtime_dir/status-launch.log"; then
          notify-send 'Codex auto-continue' 'Inställningen kunde inte ändras. Se statusfönstrets problemsektion.' 2>/dev/null || true
        else
          force_render=1
        fi
        ;;
      x|X)
        if printf '%s\n' "$base_frame" | grep -Fq '[X] Avbryt'; then
          if ! "$CODEX_STATUS_PREFERENCES_BIN" cancel-auto-pending >/dev/null 2>>"$status_runtime_dir/status-launch.log"; then
            notify-send 'Codex auto-continue' 'Den väntande åtgärden kunde inte avbrytas säkert.' 2>/dev/null || true
          fi
          force_render=1
          [[ -z $raw_frame ]] || process_snapshot
        fi
        ;;
      p|P)
        if ((paused_rendering)); then
          paused_rendering=0
          last_drawn_frame=''
          force_render=1
          [[ -z $raw_frame ]] || process_snapshot
          force_render=0
          draw_current_frame
        else
          paused_rendering=1
          frozen_frame=$base_frame
          if [[ -n $pending_source_row ]]; then
            frozen_frame=${frozen_frame//WAIT\//${pending_spinner_frames[$pending_spinner_index]}}
          fi
          draw_frame "$frozen_frame"
          last_drawn_frame=$frozen_frame
        fi
        ;;
    esac
  fi
done

#!/usr/bin/env node

'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const readline = require('readline/promises');
const { spawnSync } = require('child_process');
const {
  acquireAccountActivationLock,
  releaseAccountActivationLock,
} = require(path.join(__dirname, '..', 'lib', 'codex-activation-lock'));
const {
  accountId,
  accountsFromRegistry,
  repairableAccounts,
  validateStagedIdentity,
} = require(path.join(__dirname, '..', 'lib', 'codex-auth-repair'));
const { acquireOperationLock } = require(path.join(__dirname, '..', 'lib', 'codex-operation-lock'));
const { locations: instanceLocations } = require(path.join(__dirname, '..', 'lib', 'codex-instances'));
const { poolPaths, migrateDefault, readPool, acquireAccountLock,
  updateCredentialLocked } = require(path.join(__dirname, '..', 'lib', 'codex-account-pool'));

const codexAuthBin = process.env.CODEX_AUTH_BIN || 'codex-auth';
const usageRefresher = process.env.USAGE_REFRESHER || path.join(os.homedir(), '.local', 'bin', 'codex-usage-refresh');
const usageCachePath = process.env.USAGE_CACHE || path.join(os.homedir(), '.cache', 'codex-account-switcher', 'usage.json');
const codexLoginBin = process.env.CODEX_LOGIN_BIN || '/usr/lib/chatgpt/resources/codex';
const operationLockPath = process.env.CODEX_OPERATION_LOCK_DIR || path.join(path.dirname(usageCachePath), 'exclusive-codex-operation.lock');
const activationLockDirectory = path.join(path.dirname(usageCachePath), 'activation-locks');

function fail(message, code = 1) {
  const error = new Error(message);
  error.exitCode = code;
  throw error;
}

function readJson(filename) {
  return JSON.parse(fs.readFileSync(filename, 'utf8'));
}

function run(command, args, options = {}) {
  const result = spawnSync(command, args, {
    stdio: 'inherit',
    ...options,
  });
  if (result.error) fail(`${path.basename(command)} could not start: ${result.error.message}`);
  if (result.status !== 0) fail(`${path.basename(command)} exited without completing the repair.`);
}

function verifyFreshUsage(cachePath, wantedAccountId) {
  const cache = readJson(cachePath);
  const entry = cache?.accounts?.[wantedAccountId];
  const ageMs = Date.now() - Number(entry?.refresh?.lastSuccessAt);
  if (
    entry?.refresh?.errorKind ||
    entry?.refresh?.httpStatus !== 200 ||
    !Number.isFinite(ageMs) ||
    ageMs < 0 ||
    ageMs > 180_000
  ) {
    fail('The repaired credential did not produce fresh verified server usage.');
  }
}

let releaseHeldOperation = null;
let releasePoolAssignment = null;
let releasePoolAccount = null;
function cleanupOperation() {
  if (releasePoolAccount) { const release = releasePoolAccount; releasePoolAccount = null; release(); }
  if (releasePoolAssignment) { const release = releasePoolAssignment; releasePoolAssignment = null; release(); }
  if (!releaseHeldOperation) return;
  const release = releaseHeldOperation;
  releaseHeldOperation = null;
  release();
}
for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
  process.on(signal, () => {
    try { cleanupOperation(); } catch (error) { process.stderr.write(`Operation lock cleanup failed: ${error.message}\n`); }
    process.exit(128 + (signal === 'SIGINT' ? 2 : signal === 'SIGHUP' ? 1 : 15));
  });
}
process.on('exit', () => { try { cleanupOperation(); } catch {} });

async function chooseTarget(accounts) {
  if (accounts.length === 1) return accounts[0];
  process.stdout.write('Accounts requiring authentication repair:\n');
  accounts.forEach((account, index) => process.stdout.write(`  ${index + 1}. ${account.email || account.alias || account.account_key}\n`));
  const terminal = readline.createInterface({ input: process.stdin, output: process.stdout });
  try {
    const answer = await terminal.question(`Choose account [1-${accounts.length}]: `);
    const index = Number(answer) - 1;
    if (!Number.isInteger(index) || index < 0 || index >= accounts.length) fail('Invalid account choice.', 64);
    return accounts[index];
  } finally {
    terminal.close();
  }
}

async function main() {
  releaseHeldOperation = acquireOperationLock(operationLockPath);
  const poolLoc = instanceLocations();
  migrateDefault(poolLoc);
  let stagingRoot = null;
  let accountActivationLock = null;

  try {
    const usageCache = readJson(usageCachePath);
    const poolBeforeSelection = readPool(poolLoc);
    const candidates = repairableAccounts({ accounts: poolBeforeSelection.accounts.map(member => ({
      account_key: member.accountKey, chatgpt_account_id: member.accountId,
      email: member.email, alias: member.alias,
    })) }, usageCache);
    if (candidates.length === 0) fail('No account currently has a repairable authentication error.', 2);
    const target = await chooseTarget(candidates);
    releasePoolAssignment = acquireOperationLock(poolPaths(poolLoc).assignmentLock);
    releasePoolAccount = acquireAccountLock(poolLoc, target.account_key);
    const pool = readPool(poolLoc);
    if (!pool?.accounts.some(value => value.accountKey === target.account_key && value.accountId === accountId(target))) {
      fail('The selected account is not in the verified shared pool.', 3);
    }
    const poolMember = pool.accounts.find(value => value.accountKey === target.account_key);
    if (poolMember.accountId !== accountId(target)) fail('Pool identity changed during repair.', 3);
    accountActivationLock = acquireAccountActivationLock(activationLockDirectory, accountId(target));

    const targetLabel = target.email || target.alias || target.account_key;
    process.stdout.write(`\nRepairing authentication for ${targetLabel}.\n`);
    process.stdout.write('The normal OpenAI ChatGPT login will open in your browser.\n');
    process.stdout.write(`Make sure you sign in as ${targetLabel}. A different account will be rejected without changing your saved accounts.\n\n`);

    if (process.argv.includes('--preflight')) {
      process.stdout.write('Preflight complete. Interactive login was not started.\n');
      return;
    }

    stagingRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'codex-auth-repair-'));
    fs.chmodSync(stagingRoot, 0o700);
    fs.writeFileSync(path.join(stagingRoot, 'config.toml'), [
      'cli_auth_credentials_store = "file"',
      'forced_login_method = "chatgpt"',
      '',
    ].join('\n'), { mode: 0o600 });

    const loginPath = `${path.dirname(codexLoginBin)}:${process.env.PATH || '/usr/local/bin:/usr/bin:/bin'}`;
    run(codexAuthBin, ['login'], {
      env: { ...process.env, CODEX_HOME: stagingRoot, PATH: loginPath },
    });

    const stagedRegistry = readJson(path.join(stagingRoot, 'accounts', 'registry.json'));
    const stagedAuth = readJson(path.join(stagingRoot, 'auth.json'));
    const stagedIdentity = validateStagedIdentity({ target, stagedRegistry, stagedAuth });
    if (!stagedIdentity.ok) {
      fail(`The browser login returned a different account; no saved state was changed (${stagedIdentity.errors.join(', ')}).`, 4);
    }

    const stagedUsageCache = path.join(stagingRoot, 'usage.json');
    run(usageRefresher, [], {
      env: {
        ...process.env,
        CODEX_HOME: stagingRoot,
        CODEX_USAGE_CREDENTIAL_SOURCE: 'local',
        USAGE_CACHE: stagedUsageCache,
        USAGE_REFRESH_INTERVAL_MS: '0',
      },
    });
    verifyFreshUsage(stagedUsageCache, accountId(target));

    // codex-auth chooses its own snapshot basename; identify by account ID.
    const stagedMatches = fs.readdirSync(path.join(stagingRoot, 'accounts'))
      .filter(name => name.endsWith('.auth.json'))
      .map(name => path.join(stagingRoot, 'accounts', name))
      .filter(filename => readJson(filename)?.tokens?.account_id === accountId(target));
    if (stagedMatches.length !== 1 || !fs.existsSync(path.join(stagingRoot, 'auth.json'))) {
      fail('Verified login did not produce exactly one account snapshot.', 5);
    }
    updateCredentialLocked(target.account_key, stagedMatches[0], poolLoc, { verified: true });
    // Refresh the shared status from pool credentials. A transient usage error
    // does not roll back a credential already server-verified in staging.
    const refreshed = spawnSync(usageRefresher, [], {
      env: { ...process.env, CODEX_USAGE_CREDENTIAL_SOURCE: 'pool',
        USAGE_CACHE: usageCachePath, USAGE_REFRESH_INTERVAL_MS: '-1' },
      stdio: 'ignore', timeout: 60000,
    });
    if (refreshed.error || refreshed.status !== 0) {
      process.stderr.write('Pool credential was saved, but status usage refresh will retry later.\n');
    }
    process.stdout.write(`\nAuthentication repaired and server-verified for ${targetLabel}.\n`);
    process.stdout.write('The pool was updated. Running Desktop credentials were not changed; apply the update per instance when safe.\n');
  } catch (error) {
    process.stderr.write(`Authentication repair did not complete: ${error.message}\n`);
    process.exitCode = error.exitCode || 1;
  } finally {
    if (stagingRoot) fs.rmSync(stagingRoot, { recursive: true, force: true });
    releaseAccountActivationLock(accountActivationLock);
    cleanupOperation();
  }
}

async function holdTerminalIfRequested() {
  if (!process.argv.includes('--hold') || !process.stdin.isTTY || !process.stdout.isTTY) return;
  const terminal = readline.createInterface({ input: process.stdin, output: process.stdout });
  try {
    await terminal.question('\nPress Enter to close this window.');
  } finally {
    terminal.close();
  }
}

main()
  .catch(error => {
    process.stderr.write(`Authentication repair could not start: ${error.message}\n`);
    process.exitCode = error.exitCode || 1;
  })
  .finally(holdTerminalIfRequested);

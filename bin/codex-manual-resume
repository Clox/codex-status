function readJson(filename, fallback = null) {
  try { return JSON.parse(fs.readFileSync(filename, 'utf8')); } catch { return fallback; }
}

function readDraftJournal() {
  try {
    const journal = JSON.parse(fs.readFileSync(draftJournalPath, 'utf8'));
    return journal?.version === 1 && journal.claims && typeof journal.claims === 'object'
      ? journal : { unverified: true };
  } catch (error) {
    return error?.code === 'ENOENT' ? { version: 1, claims: {} } : { unverified: true };
  }
}

function sleep(milliseconds) {
  return new Promise(resolve => setTimeout(resolve, milliseconds));
}

function processEntries() {
  const entries = [];
  for (const name of fs.readdirSync('/proc')) {
    if (!/^\d+$/.test(name)) continue;
    const pid = Number(name);
    try {
      const args = fs.readFileSync(`/proc/${pid}/cmdline`).toString().split('\0').filter(Boolean);
      const status = fs.readFileSync(`/proc/${pid}/status`, 'utf8');
      const stat = fs.readFileSync(`/proc/${pid}/stat`, 'utf8');
      const statFields = stat.slice(stat.lastIndexOf(')') + 2).trim().split(/\s+/);
      const ppid = Number(status.match(/^PPid:\s+(\d+)/m)?.[1]);
      const state = status.match(/^State:\s+(\S)/m)?.[1] || '?';
      const startTicks = Number(statFields[19]);
      let exe = null;
      let cgroup = null;
      try { exe = fs.readlinkSync(`/proc/${pid}/exe`).replace(/ \(deleted\)$/, ''); } catch {}
      try { cgroup = fs.readFileSync(`/proc/${pid}/cgroup`, 'utf8').split('\n')
        .find(line => line.startsWith('0::'))?.slice(3) || null; } catch {}
      entries.push({ pid, ppid, state, args, startTicks: Number.isFinite(startTicks) ? startTicks : null,
        exe, cgroup });
    } catch {}
  }
  return entries;
}

function isDesktopRoot(entry) {
  return isDesktopRootProcess(entry, desktopBinary);
}

function descendants(entries, roots) {
  const result = new Set(roots);
  let changed = true;
  while (changed) {
    changed = false;
    for (const entry of entries) {
      if (result.has(entry.ppid) && !result.has(entry.pid)) {
        result.add(entry.pid);
        changed = true;
      }
    }
  }
  return [...result];
}

function processExists(pid) {
  try { process.kill(pid, 0); return true; } catch { return false; }
}

function signalExisting(pids, signal) {
  for (const pid of pids) {
    try { process.kill(pid, signal); } catch (error) {
      if (error?.code !== 'ESRCH') throw error;
    }
  }
}

async function waitUntil(predicate, timeoutMs, errorKind) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    if (predicate()) return;
    await sleep(100);
  }
  throw new Error(errorKind);
}

function discoverClientProcesses() {
  const entries = processEntries();
  const vscodeServers = entries.filter(isVsCodeCodexAppServerProcess);
  const vscodeHosts = [...new Set(vscodeServers.map(server => server.ppid))];
  for (const hostPid of vscodeHosts) {
    const host = entries.find(entry => entry.pid === hostPid);
    if (!host || !host.args.includes('--utility-sub-type=node.mojom.NodeService')) {
      throw new Error('VSCODE_EXTENSION_HOST_UNVERIFIED');
    }
  }
  return {
    vscodeHosts,
    vscodePids: descendants(entries, vscodeHosts),
    desktopRoots: entries.filter(isDesktopRoot).map(entry => entry.pid),
    desktopLineage: captureDesktopLineage(entries, entries.filter(isDesktopRoot).map(entry => entry.pid)),
  };
}

function blockerSummary(blockers) {
  return blockers.map(blocker =>
    `${blocker.role} pid=${blocker.pid} ppid=${blocker.ppid} state=${blocker.state}`
  ).join('; ');
}

async function waitForAppServerExclusivity(desktopLineage, timeoutMs = 15_000) {
  let lineage = desktopLineage;
  const result = await pollAppServerExclusivity({
    readReport: () => {
      const entries = processEntries();
      lineage = captureDesktopLineage(entries, [], lineage);
      return appServerExclusivityReport(entries, {
      desktopLineage: lineage,
      ignoredPids: [process.pid],
      });
    },
    sleep,
    timeoutMs,
  });
  if (result.outcome === 'exclusive') return;
  const error = new Error('APP_SERVER_EXCLUSIVITY_FAILED');
  error.diagnostics = {
    phase: 'acquire-app-server-exclusivity',
    failureReason: 'APP_SERVER_EXCLUSIVITY_FAILED',
    blockers: result.report.blockers,
  };
  throw error;
}

function desktopRootIdentities() {
  return processEntries().filter(isDesktopRoot).map(({ pid, startTicks, cgroup }) =>
    ({ pid, startTicks, cgroup }));
}

function launchDesktopOnce(attempt, { forceRendererAccessibility = false } = {}) {
  const spec = desktopRestoreLaunchSpec({
    systemdRunBin,
    desktopLauncher,
    controllerPid: process.pid,
    attempt,
    desktopArgs: forceRendererAccessibility ? ['--force-renderer-accessibility'] : [],
  });
  const child = spawn(spec.command, spec.args, { detached: true, stdio: 'ignore' });
  child.unref();
  return { pid: child.pid, unit: `codex-desktop-restore-${process.pid}-${attempt}.service` };
}

async function restoreClients(lease, {
  removeLease = true,
  forceDesktop = false,
  forceRendererAccessibility = false,
} = {}) {
  signalExisting([...(lease.vscodePids || [])].reverse(), 'SIGCONT');
  let desktopRestore = null;
  if (lease.desktopWasRunning || forceDesktop) {
    desktopRestore = await restoreDesktopWithRetry({
      readRoots: desktopRootIdentities,
      launch: attempt => launchDesktopOnce(attempt, { forceRendererAccessibility }),
      sleep,
    });
  }
  if (removeLease) {
    try { fs.unlinkSync(leasePath); } catch {}
  }
  return { desktopRestore };
}

async function watchdogMode() {
  while (fs.existsSync(leasePath)) {
    const lease = readJson(leasePath);
    if (!lease?.controllerPid || !processExists(lease.controllerPid)) {
      if (lease) await restoreClients(lease);
      return;
    }
    await sleep(500);
  }
}

function startWatchdog(lease) {
  atomicWriteJson(leasePath, lease);
  const child = spawn(process.execPath, [__filename, '--restore-watchdog'], {
    detached: true,
    stdio: 'ignore',
    env: process.env,
  });
  child.unref();
}

async function acquireExclusiveClients({ autoMode = false } = {}) {
  const discovered = discoverClientProcesses();
  const autoBlocker = autoMode ? automaticClientBlocker(processEntries()) : null;
  if (autoBlocker) {
    const error = new Error(autoBlocker.errorKind);
    error.diagnostics = autoBlocker;
    throw error;
  }
  const lease = {
    version: 1,
    controllerPid: process.pid,
    createdAtMs: Date.now(),
    vscodePids: discovered.vscodePids,
    desktopWasRunning: discovered.desktopRoots.length > 0,
  };
  startWatchdog(lease);
  try {
    // Stop extension hosts first so they cannot enqueue more work, then all
    // descendants. SIGCONT later restores the exact same in-memory client.
    signalExisting(discovered.vscodeHosts, 'SIGSTOP');
    const stoppedTree = descendants(processEntries(), discovered.vscodeHosts);
    signalExisting(stoppedTree, 'SIGSTOP');
    lease.vscodePids = [...new Set([...lease.vscodePids, ...stoppedTree])];
    atomicWriteJson(leasePath, lease);
    await waitUntil(() => lease.vscodePids.every(pid => {
      const entry = processEntries().find(candidate => candidate.pid === pid);
      return !entry || entry.state === 'T' || entry.state === 't';
    }), 5_000, 'VSCODE_CLIENT_NOT_QUIESCENT');

    signalExisting(discovered.desktopRoots, 'SIGTERM');
    let desktopLineage = discovered.desktopLineage;
    await waitUntil(() => {
      const entries = processEntries();
      desktopLineage = captureDesktopLineage(entries, [], desktopLineage);
      return !entries.some(isDesktopRoot);
    }, 15_000, 'DESKTOP_DID_NOT_STOP');

    // Electron's root can exit slightly before its App Server child. Wait for
    // that already identified Desktop tree to drain, while every unknown or
    // non-quiescent App Server remains a fail-closed blocker.
    await waitForAppServerExclusivity(desktopLineage);
    return lease;
  } catch (error) {
    await restoreClients(lease);
    throw error;
  }
}

function activeAccountState() {
  const registry = readJson(registryPath);
  const globalAuth = readJson(globalAuthPath);
  if (!registry || !globalAuth) throw new Error('ACTIVE_AUTH_STATE_MISSING');
  const accounts = Array.isArray(registry.accounts) ? registry.accounts : Object.values(registry.accounts || {});
  const active = accounts.find(account => account.account_key === registry.active_account_key);
  if (!active) throw new Error('ACTIVE_ACCOUNT_MISSING');
  const expected = { accountId: active.chatgpt_account_id || active.accountId, accountKey: active.account_key };
  if (!expected.accountId || !expected.accountKey) throw new Error('ACTIVE_ACCOUNT_IDENTITY_INCOMPLETE');
  const verified = verifyActiveAccountState({
    registry,
    globalAuth,
    expectedAccountId: expected.accountId,
    expectedAccountKey: expected.accountKey,
  });
  if (!verified.ok) throw new Error('ACTIVE_AUTH_POSTCONDITION_FAILED');
  return { accountId: expected.accountId, accountKey: expected.accountKey };
}

function assertFreshUsableTarget(accountId) {
  const cache = readJson(usageCachePath, {});
  const entry = cache?.accounts?.[accountId];
  const successAt = Number(entry?.refresh?.lastSuccessAt);
  if (!entry || !Number.isFinite(successAt) || Date.now() - successAt > MAX_USAGE_AGE_MS) {
    throw new Error('TARGET_USAGE_NOT_VERIFIED');
  }
  if (entry.refresh?.errorKind || Number(entry.refresh?.consecutiveFailures) > 0) {
    throw new Error('TARGET_USAGE_NOT_VERIFIED');
  }
  if (!(Number(entry.primary?.remainingPercent) > 0 && Number(entry.secondary?.remainingPercent) > 0)) {
    throw new Error('TARGET_ACCOUNT_NOT_USABLE');
  }
}

function assertObserverIdle(eventState, candidate) {
  if (!observerHealth(eventState, Date.now()).healthy) throw new Error('TURN_OBSERVER_UNVERIFIED');
  if (Object.keys(eventState.activeTurns || {}).length > 0) throw new Error('CODEX_TURNS_STILL_ACTIVE');
  const persisted = eventState.interruptedTurns?.[candidateKey(candidate.threadId, candidate.turnId)];
  if (!persisted?.resumable || persisted.threadIdentityVerified !== true) throw new Error('CANDIDATE_NO_LONGER_RESUMABLE');
  return persisted;
}

class RpcConnection {
  constructor(child, { interactiveApprovals = true } = {}) {
    this.child = child;
    this.nextId = 1;
    this.pending = new Map();
    this.notifications = [];
    this.waiters = new Set();
    this.buffer = '';
    this.failure = null;
    this.phase = 'startup';
    this.receivedMessages = [];
    this.interactiveApprovals = interactiveApprovals;
    child.stdout.setEncoding('utf8');
    child.stdout.on('data', chunk => this.onData(chunk));
    child.stderr.on('data', () => {});
    child.on('error', () => this.fail(new Error('APP_SERVER_START_FAILED')));
    child.on('exit', () => this.fail(new Error('APP_SERVER_EXITED')));
  }

  onData(chunk) {
    let decoded;
    try {
      decoded = splitJsonLines(this.buffer, chunk, MAX_PROTOCOL_FRAME_BYTES);
    } catch (error) {
      error.diagnostics = {
        phase: this.phase,
        ...(error.diagnostics || {}),
        receivedMessages: this.receivedMessages.slice(-32),
      };
      return this.fail(error);
    }
    this.buffer = decoded.remaining;
    for (const line of decoded.lines) {
      let message;
      try { message = JSON.parse(line); } catch { return this.fail(new Error('APP_SERVER_PROTOCOL_MISMATCH')); }
      this.onMessage(message);
    }
  }

  onMessage(message) {
    if (message.id !== undefined && !message.method) {
      const pending = this.pending.get(message.id);
      if (!pending) return;
      this.recordMessage({ kind: 'response', method: pending.method, ok: !message.error });
      this.pending.delete(message.id);
      if (message.error) {
        const error = new Error('APP_SERVER_REQUEST_FAILED');
        error.diagnostics = { phase: this.phase, method: pending.method,
          errorCode: Number.isFinite(Number(message.error.code)) ? Number(message.error.code) : null };
        pending.reject(error);
      } else pending.resolve(message.result);
      return;
    }
    if (message.id !== undefined && message.method) {
      this.recordMessage({ kind: 'server-request', method: message.method });
      this.handleServerRequest(message).catch(() => {
        this.respond(message.id, null, { code: -32603, message: 'Manual resume client could not safely answer request' });
      });
      return;
    }
    this.recordMessage({ kind: 'notification', method: message.method || 'unknown' });
    this.notifications.push(message);
    if (this.notifications.length > 512) this.notifications.shift();
    for (const waiter of [...this.waiters]) {
      if (waiter.predicate(message)) {
        this.waiters.delete(waiter);
        waiter.resolve(message);
      }
    }
  }

  setPhase(phase) {
    this.phase = phase;
  }

  recordMessage(summary) {
    this.receivedMessages.push(summary);
    if (this.receivedMessages.length > 64) this.receivedMessages.shift();
  }

  async handleServerRequest(message) {
    const method = message.method;
    if (method === 'item/commandExecution/requestApproval' || method === 'item/fileChange/requestApproval') {
      if (!this.interactiveApprovals) {
        this.respond(message.id, { decision: 'decline' });
        return;
      }
      const accepted = await ask(`${method.includes('command') ? 'Kommando' : 'Filändring'} kräver godkännande. Godkänn? [y/N] `);
      this.respond(message.id, { decision: /^y(es)?$/i.test(accepted.trim()) ? 'accept' : 'decline' });
      return;
    }
    if (method === 'item/permissions/requestApproval') {
      this.respond(message.id, { permissions: {} });
      return;
    }
    if (method === 'item/tool/requestUserInput') {
      this.respond(message.id, { answers: {} });
      return;
    }
    if (method === 'mcpServer/elicitation/request') {
      this.respond(message.id, { action: 'decline', content: null });
      return;
    }
    this.respond(message.id, null, { code: -32601, message: 'Unsupported server request during manual resume' });
  }

  respond(id, result, error = null) {
    this.child.stdin.write(`${JSON.stringify(error ? { id, error } : { id, result })}\n`);
  }

  request(method, params) {
    if (this.failure) return Promise.reject(this.failure);
    const id = this.nextId++;
    const promise = new Promise((resolve, reject) => this.pending.set(id, { resolve, reject, method }));
    this.child.stdin.write(`${JSON.stringify({ id, method, params })}\n`);
    return promise;
  }

  notify(method, params = {}) {
    this.child.stdin.write(`${JSON.stringify({ method, params })}\n`);
  }

  waitFor(predicate) {
    const index = this.notifications.findIndex(predicate);
    if (index >= 0) return Promise.resolve(this.notifications.splice(index, 1)[0]);
    return new Promise((resolve, reject) => this.waiters.add({ predicate, resolve, reject }));
  }

  fail(error) {
    if (this.failure) return;
    this.failure = error;
    for (const pending of this.pending.values()) pending.reject(error);
    for (const waiter of this.waiters) waiter.reject(error);
    this.pending.clear();
    this.waiters.clear();
  }
}

class DesktopAtspiController {
  constructor() {
    this.child = spawn(desktopAtspiBin, [], { stdio: ['pipe', 'pipe', 'pipe'] });
    this.lines = readline.createInterface({ input: this.child.stdout });
    this.responses = [];
    this.waiters = [];
    this.failure = null;
    this.child.stderr.on('data', () => {});
    this.lines.on('line', line => {
      let response;
      try { response = JSON.parse(line); } catch { return this.fail(new Error('DESKTOP_ATSPI_PROTOCOL_MISMATCH')); }
      const waiter = this.waiters.shift();
      if (waiter) waiter.resolve(response);
      else this.responses.push(response);
    });
    this.child.on('error', () => this.fail(new Error('DESKTOP_ATSPI_START_FAILED')));
    this.child.on('exit', () => this.fail(new Error('DESKTOP_ATSPI_EXITED')));
  }

  fail(error) {
    if (this.failure) return;
    this.failure = error;
    for (const waiter of this.waiters.splice(0)) waiter.reject(error);
  }

  async request(command, timeoutMs = 10_000) {
    if (this.failure) throw this.failure;
    const pending = this.responses.length > 0
      ? Promise.resolve(this.responses.shift())
      : new Promise((resolve, reject) => this.waiters.push({ resolve, reject }));
    this.child.stdin.write(`${JSON.stringify(command)}\n`);
    const response = await withTimeout(pending, timeoutMs);
    if (response?.ok !== true) throw new Error(response?.errorKind || 'DESKTOP_ATSPI_FAILED');
    return response;
  }

  async close() {
    try { await this.request({ command: 'close' }, 1_000); } catch {}
    await terminateChild(this.child);
  }
}

function ask(prompt) {
  const terminal = readline.createInterface({ input: process.stdin, output: process.stdout });
  return new Promise(resolve => terminal.question(prompt, answer => { terminal.close(); resolve(answer); }));
}

function withTimeout(promise, milliseconds) {
  let timer;
  return Promise.race([
    promise.finally(() => clearTimeout(timer)),
    new Promise((_, reject) => { timer = setTimeout(() => reject(new Error('APP_SERVER_TIMEOUT')), milliseconds); }),
  ]);
}

async function terminateChild(child) {
  if (child.exitCode !== null || child.signalCode !== null) return;
  const exited = once(child, 'exit').catch(() => {});
  child.stdin.end();
  child.kill('SIGTERM');
  await Promise.race([exited, sleep(1500)]);
  if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL');
}

async function runResume(candidate, targetAccountId, onCommit, { automatic = false } = {}) {
  const continuation = continuationForCandidate(candidate);
  if (!continuation.ok || candidate.classificationVerified !== true) {
    throw new Error(continuation.reason || 'CANDIDATE_CLASSIFICATION_UNVERIFIED');
  }
  const child = spawn(codexBin, ['-c', 'features.code_mode_host=true', 'app-server', '--analytics-default-enabled'], {
    cwd: candidate.cwd || os.homedir(),
    env: { ...process.env, CODEX_HOME: codexHome },
    stdio: ['pipe', 'pipe', 'pipe'],
  });
  const rpc = new RpcConnection(child, { interactiveApprovals: !automatic });
  try {
    return await withTimeout((async () => {
      const requests = resumeProtocolRequests(candidate.threadId);
      rpc.setPhase('initialize');
      await rpc.request('initialize', {
        clientInfo: { name: 'codex_manual_resume', title: 'Codex Manual Resume', version: '1.0.0' },
        capabilities: { experimentalApi: true, requestAttestation: false },
      });
      rpc.notify('initialized');
      rpc.setPhase('thread-read-metadata');
      const read = await rpc.request('thread/read', requests.read);
      const eventState = readJson(eventStatePath, {});
      const resumeState = normalizeResumeState(readJson(resumeStatePath, emptyResumeState()));
      validateThreadMetadataForResume({ candidate, thread: read?.thread, eventState, resumeState });
      rpc.setPhase('thread-resume');
      const resumed = await rpc.request('thread/resume', requests.resume);
      if (resumed?.thread?.id !== candidate.threadId || resumed.thread.status?.type !== 'idle') {
        throw new Error('THREAD_RESUME_POSTCONDITION_FAILED');
      }
      rpc.setPhase('thread-turns-list');
      const turns = await rpc.request('thread/turns/list', requests.latestTurn);
      validateThreadForResume({
        candidate,
        thread: {
          ...(resumed.thread || {}),
          turns: Array.isArray(turns?.data) ? turns.data : [],
        },
        eventState: readJson(eventStatePath, {}),
        resumeState: normalizeResumeState(readJson(resumeStatePath, emptyResumeState())),
      });
      rpc.setPhase('pre-turn-commit');
      await onCommit(child.pid, continuation);
      rpc.setPhase('turn-start');
      const started = await rpc.request('turn/start', {
        threadId: candidate.threadId,
        input: continuation.input,
        turnTrigger: automatic ? 'automatic-quota-resume' : 'manual-quota-resume',
      });
      const turnId = started?.turn?.id;
      if (!turnId) throw new Error('TURN_START_OUTCOME_UNKNOWN');
      rpc.setPhase('turn-running');
      const terminal = await rpc.waitFor(message =>
        message.method === 'turn/completed' &&
        message.params?.threadId === candidate.threadId &&
        message.params?.turn?.id === turnId
      );
      return {
        turnId,
        status: terminal.params.turn.status,
        errorKind: codexErrorKind(terminal.params.turn.error),
        targetAccountId,
      };
    })(), TURN_TIMEOUT_MS);
  } finally {
    await terminateChild(child);
  }
}

function acquireLock() {
  try { heldRelease = acquireOperationLock(lockPath); return heldRelease; }
  catch (error) { if (error.code === 'ELOCKED') throw new Error('RESUME_ALREADY_RUNNING'); throw error; }
}

let heldRelease = null;
function releaseLock(lock) {
  const release = typeof lock === 'function' ? lock : heldRelease;
  if (release) release();
  if (release === heldRelease) heldRelease = null;
}

function autoSelectors() {
  const current = readJson(registryPath);
  const accounts = Array.isArray(current?.accounts) ? current.accounts : Object.values(current?.accounts || {});
  const selectors = accounts.map(account => account.account_key);
  if (!selectors.length || selectors.some(selector => !selector)) throw new Error('AUTO_ACCOUNT_SELECTORS_MISSING');
  return selectors;
}

function autoDecisionSnapshot(nowMs = Date.now()) {
  const preferences = readStatusPreferences(statusPreferencesPath);
  const registry = readJson(registryPath);
  const globalAuth = readJson(globalAuthPath);
  const usageCache = readJson(usageCachePath);
  const eventState = normalizeState(readJson(eventStatePath, {}), nowMs);
  const resumeState = normalizeResumeState(readJson(resumeStatePath, emptyResumeState()));
  const manualDraftJournal = readDraftJournal();
  if (!registry || !globalAuth || !usageCache) throw new Error('AUTO_STATE_MISSING');
  return automationDecision({
    preferences,
    registry,
    globalAuth,
    usageCache,
    eventState,
    resumeState,
    manualDraftJournal,
    selectors: autoSelectors(),
    nowMs,
  });
}

async function inspectAutomaticCandidate(candidate) {
  const storage = await headlessStoragePreflight(codexHome, [candidate]);
  if (!storage.ok) return storage;
  const eventState = normalizeState(readJson(eventStatePath, {}), Date.now());
  if (!observerHealth(eventState, Date.now()).healthy) {
    return { ok: false, reason: 'TURN_OBSERVER_UNVERIFIED', blocksAutomation: true,
      requiredAction: 'wait for observer recovery' };
  }
  return automaticCandidateEligibility(candidate, eventState, storage);
}

async function partitionAutomaticPlan(decision, previousBlocks) {
  return partitionAutomaticCandidates(decision, inspectAutomaticCandidate, previousBlocks);
}

function writeAutoContinueState(patch) {
  const previous = normalizeAutoContinueState(readJson(autoContinueStatePath, emptyAutoContinueState()));
  const resolved = patch.desktopRestore?.status === 'ready'
    ? resolveDesktopRestoreFailure(previous, {
      pid: patch.desktopRestore.desktopPid,
      startTicks: patch.desktopRestore.desktopStartTicks,
      cgroup: patch.desktopRestore.desktopCgroup,
    }) : previous;
  atomicWriteJson(autoContinueStatePath, {
    ...emptyAutoContinueState(),
    ...resolved,
    ...patch,
    ...(patch.desktopRestore?.status === 'failed' ? { restoreRetryHalt: true } : {}),
    version: AUTO_CONTINUE_STATE_VERSION,
    heartbeatAtMs: Date.now(),
  });
}

function readAutoContinueState() {
  return normalizeAutoContinueState(readJson(autoContinueStatePath, emptyAutoContinueState()));
}

async function retireBlockedCandidates(blocked, blocks, { lockHeld = false } = {}) {
  const nowMs = Date.now();
  const due = blocked.filter(candidate => {
    const block = blocks[candidateKey(candidate.threadId, candidate.turnId)];
    return block?.reason === 'ROLLOUT_NOT_IN_ACTIVE_CODEX_HOME' &&
      nowMs - candidate.completedAtMs >= MIN_CANDIDATE_AGE_MS &&
      nowMs - block.continuousMissingSinceMs >= MIN_CONTINUOUS_MISSING_MS;
  });
  if (!due.length) return [];
  let lock = null;
  try {
    if (!lockHeld) lock = acquireLock();
    let raw;
    try { raw = JSON.parse(fs.readFileSync(resumeStatePath, 'utf8')); } catch { return []; }
    if (raw.version !== RESUME_STATE_VERSION || !raw.attempts || typeof raw.attempts !== 'object') return [];
    let journal = normalizeResumeState(raw);
    const draftJournal = readDraftJournal();
    if (draftJournal.unverified === true) return [];
    const eventState = normalizeState(readJson(eventStatePath, {}), Date.now());
    if (!observerHealth(eventState, Date.now()).healthy) return [];
    const retired = [];
    for (const candidate of due) {
      const block = blocks[candidateKey(candidate.threadId, candidate.turnId)];
      const storage = await headlessStoragePreflight(codexHome, [candidate]);
      if (!retirementEligible({ candidate, block, eventState, resumeState: journal,
        draftJournal, autoState: readAutoContinueState(), storage,
        observerHealthy: observerHealth(eventState, Date.now()).healthy, nowMs: Date.now() })) continue;
      journal = retireUnavailable(journal, candidate, block, Date.now());
      retired.push(candidate);
    }
    if (retired.length) atomicWriteJson(resumeStatePath, journal);
    return retired;
  } catch (error) {
    if (!lockHeld && error?.message === 'RESUME_ALREADY_RUNNING') return [];
    throw error;
  } finally {
    if (lock) releaseLock();
  }
}

function sendPendingNotification(pending) {
  const result = spawnSync(notifySendBin, [
    '-r', String(pending.notificationReplaceId),
    'Codex behöver byta konto',
    'ChatGPT startas om automatiskt om 10 sekunder. Öppna Codex-status för att avbryta.',
  ], { stdio: 'ignore', timeout: 5_000 });
  const deliveredAtMs = !result.error && result.status === 0 ? Date.now() : null;
  const state = readAutoContinueState();
  if (state.pending?.fingerprint !== pending.fingerprint) return;
  writeAutoContinueState({
    lastNotifiedPendingFingerprint: pending.fingerprint,
    pending: {
      ...state.pending,
      notificationDeliveredAtMs: deliveredAtMs,
      notificationErrorKind: deliveredAtMs ? null : 'NOTIFY_SEND_FAILED',
    },
  });
}

async function awaitPendingCountdown(expectedPlan, blocked = []) {
  while (true) {
    const currentPlan = autoDecisionSnapshot();
    if (!sameHeadlessDecisionPlan(expectedPlan, currentPlan, blocked)) return 'changed';
    const gate = pendingCountdownDecision(readAutoContinueState(),
      selectHeadlessPlan(currentPlan, blocked), Date.now());
    if (gate.action !== 'wait') return gate.action;
    await sleep(Math.min(AUTO_PENDING_POLL_MS, gate.remainingMs));
  }
}

function refreshUsageNow() {
  const result = spawnSync(usageRefresher, [], {
    env: { ...process.env, USAGE_REFRESH_INTERVAL_MS: '0' },
    stdio: 'ignore',
    timeout: 30_000,
  });
  if (result.error || result.status !== 0) throw new Error('AUTO_USAGE_REFRESH_FAILED');
}

function switchToTarget(target) {
  const result = runAccountSwitch({ codexHome, targetAccountKey: target.accountKey,
    authBin: codexAuthBin, source: 'auto' });
  if (result.target.accountId !== target.accountId) throw new Error('AUTO_ACCOUNT_SWITCH_POSTCONDITION_FAILED');
  return result.switched;
}

function assertAutomaticOwnership(controlledAppServerPid = null) {
  const entries = processEntries();
  const autoBlocker = automaticClientBlocker(entries);
  if (autoBlocker) throw new Error(autoBlocker.errorKind);
  const discovered = discoverClientProcesses();
  if (discovered.desktopRoots.length > 0) throw new Error('AUTO_DESKTOP_REAPPEARED');
  const report = appServerExclusivityReport(entries, {
    ignoredPids: [process.pid, controlledAppServerPid].filter(Boolean),
  });
  if (!report.exclusive) {
    const error = new Error('APP_SERVER_EXCLUSIVITY_FAILED');
    error.diagnostics = { blockers: report.blockers };
    throw error;
  }
}

async function waitForObserverIdleAfterTurn(timeoutMs = 15_000) {
  await waitUntil(() => {
    const state = normalizeState(readJson(eventStatePath, {}), Date.now());
    return observerHealth(state, Date.now()).healthy && Object.keys(state.activeTurns || {}).length === 0;
  }, timeoutMs, 'TURN_OBSERVER_DID_NOT_SETTLE');
}

async function automaticHeadlessMain() {
  const initial = autoDecisionSnapshot();
  if (initial.action !== 'resume') {
    const observed = readAutoContinueState();
    const previous = reconcileSuppression(observed.errorKind === 'SOURCE_EXHAUSTION_CHANGED'
      ? recordPrecommitPlanChange(observed, observed.errorKind, {
        threadId: observed.candidateThreadId, failedTurnId: observed.candidateTurnId,
        targetAccountId: observed.targetAccountId,
      }) : observed, initial);
    const reconciled = initial.reason === 'no-candidates' || initial.reason === 'disabled'
      ? clearExclusivityBlock(previous) : previous;
    let candidateBlocks = reconciled.candidateBlocks;
    if (initial.action !== 'disabled' && initial.reason !== 'no-candidates' &&
        initial.reason !== 'observer-unverified') {
      const manualDraftJournal = readDraftJournal();
      if (manualDraftJournal.unverified !== true) {
        const eventState = normalizeState(readJson(eventStatePath, {}), Date.now());
        const resumeState = normalizeResumeState(readJson(resumeStatePath, emptyResumeState()));
        const candidates = headlessDiagnosticCandidates(eventState, resumeState, manualDraftJournal);
        const diagnostics = await partitionAutomaticPlan({ candidates }, candidateBlocks);
        candidateBlocks = diagnostics.candidateBlocks;
        await retireBlockedCandidates(diagnostics.blocked, candidateBlocks);
      }
    }
    writeAutoContinueState({
      ...reconciled,
      status: initial.action,
      phase: null,
      sourceAccountId: null,
      waitingReason: initial.action === 'waiting' ? initial.reason : null,
      lastAttemptAtMs: Date.now(),
      errorKind: initial.action === 'blocked' ? initial.reason : null,
      actionRequired: initial.actionRequired === true,
      candidateThreadId: null,
      candidateTurnId: null,
      targetAccountId: null,
      pending: null,
      candidateBlocks: initial.reason === 'no-candidates' ? {} : candidateBlocks,
    });
    return;
  }

  let lock = null;
  let lease = null;
  let currentCandidate = null;
  let committed = false;
  let lastTerminalThreadId = null;
  let lastTerminalFailedTurnId = null;
  let lockedPlan = initial;
  let blockedCandidates = [];
  let shouldReplan = false;
  let navigationPhase = false;
  try {
    lock = acquireLock();
    const fullPlan = autoDecisionSnapshot();
    if (!sameDecisionPlan(initial, fullPlan)) throw new Error('AUTO_PLAN_CHANGED_BEFORE_OWNERSHIP');
    const partition = await partitionAutomaticPlan(fullPlan, readAutoContinueState().candidateBlocks);
    lockedPlan = partition.plan;
    blockedCandidates = partition.blocked;
    writeAutoContinueState({ candidateBlocks: partition.candidateBlocks });
    const retired = await retireBlockedCandidates(blockedCandidates, partition.candidateBlocks, { lockHeld: true });
    const retiredKeys = new Set(retired.map(candidate => candidateKey(candidate.threadId, candidate.turnId)));
    blockedCandidates = blockedCandidates.filter(candidate =>
      !retiredKeys.has(candidateKey(candidate.threadId, candidate.turnId)));
    if (lockedPlan.candidates.length === 0) {
      const onlyUnavailable = blockedCandidates.length > 0 && blockedCandidates.every(candidate =>
        isolatedUnavailableReason(
          partition.candidateBlocks[candidateKey(candidate.threadId, candidate.turnId)]?.reason) &&
        partition.candidateBlocks[candidateKey(candidate.threadId, candidate.turnId)]?.blocksAutomation !== true &&
        !partition.candidateBlocks[candidateKey(candidate.threadId, candidate.turnId)]?.requiredAction);
      writeAutoContinueState({ status: onlyUnavailable || blockedCandidates.length === 0 ? 'waiting' : 'blocked',
        phase: null, sourceAccountId: null,
        waitingReason: blockedCandidates.length === 0 ? 'no-candidates' :
          (onlyUnavailable ? 'unavailable-candidates' : null),
        errorKind: null, actionRequired: false, pending: null,
        candidateBlocks: blockedCandidates.length === 0 ? {} : partition.candidateBlocks,
        candidateThreadId: onlyUnavailable ? null : blockedCandidates[0]?.threadId || null,
        candidateTurnId: onlyUnavailable ? null : blockedCandidates[0]?.turnId || null,
        targetAccountId: fullPlan.target.accountId });
      return;
    }
    const beforeRetry = readAutoContinueState();
    const reconciledFailure = reconcileFailedAutomaticAttempt(beforeRetry, lockedPlan);
    if (reconciledFailure.restoreRetryHalt && !beforeRetry.restoreRetryHalt) {
      writeAutoContinueState({ ...reconciledFailure, status: 'blocked', actionRequired: true });
      return;
    }
    if (restoreFailureBlocksAuto(readAutoContinueState(), lockedPlan)) {
      const blocked = readAutoContinueState();
      writeAutoContinueState({ status: 'blocked', errorKind: blocked.errorKind ||
        blocked.desktopRestore?.errorKind || 'AUTO_ATTEMPT_RETRY_HALTED', actionRequired: true,
        candidateThreadId: lockedPlan.candidates[0].threadId,
        candidateTurnId: lockedPlan.candidates[0].turnId,
        targetAccountId: lockedPlan.target.accountId, pending: null });
      return;
    }
    // Do not quiesce and restore Desktop again while the same blocker is alive.
    if (hasMatchingExclusivityBlock(readAutoContinueState(), {
      threadId: lockedPlan.candidates[0].threadId,
      failedTurnId: lockedPlan.candidates[0].turnId,
      targetAccountId: lockedPlan.target.accountId,
    }) && unresolvedExclusivityBlockerPresent(readAutoContinueState(), processEntries())) {
      writeAutoContinueState({ lastAttemptAtMs: Date.now() });
      return;
    }
    if (isAutoPlanSuppressed(readAutoContinueState(), lockedPlan)) {
      writeAutoContinueState({
        status: 'suppressed',
        pending: null,
        errorKind: null,
        actionRequired: false,
        candidateThreadId: lockedPlan.candidates[0]?.threadId || null,
        candidateTurnId: lockedPlan.candidates[0]?.turnId || null,
        targetAccountId: lockedPlan.target.accountId,
      });
      return;
    }
    const processSnapshot = processEntries();
    const autoBlocker = automaticClientBlocker(processSnapshot);
    if (autoBlocker) {
      const blockerError = new Error(autoBlocker.errorKind);
      blockerError.diagnostics = autoBlocker;
      throw blockerError;
    }
    const desktopRunning = processSnapshot.some(isDesktopRoot);
    const exclusivityContext = {
      threadId: lockedPlan.candidates[0]?.threadId || null,
      failedTurnId: lockedPlan.candidates[0]?.turnId || null,
      targetAccountId: lockedPlan.target.accountId,
    };
    const retryingExclusivity = hasMatchingExclusivityBlock(readAutoContinueState(), exclusivityContext);
    if (!retryingExclusivity && requiresPendingCountdown(lockedPlan, desktopRunning)) {
      const prepared = createOrResumePending(readAutoContinueState(), lockedPlan);
      writeAutoContinueState(prepared.state);
      if (prepared.notificationClaimed) sendPendingNotification(prepared.state.pending);
      if (prepared.outcome === 'suppressed') return;
      const countdownOutcome = await awaitPendingCountdown(lockedPlan, blockedCandidates);
      if (countdownOutcome === 'canceled') return;
      if (countdownOutcome !== 'execute') throw new Error('AUTO_PLAN_CHANGED_DURING_COUNTDOWN');
      const expiredPlan = autoDecisionSnapshot();
      if (!sameHeadlessDecisionPlan(lockedPlan, expiredPlan, blockedCandidates)) {
        throw new Error('AUTO_PLAN_CHANGED_DURING_COUNTDOWN');
      }
    }
    const attemptState = beginExclusivityAttempt(adoptAutomaticPlan(readAutoContinueState()), exclusivityContext, {
      status: 'running',
      phase: 'preparing',
      sourceAccountId: initial.active?.accountId || null,
      lastAttemptAtMs: Date.now(),
      errorKind: null,
      actionRequired: false,
      candidateThreadId: lockedPlan.candidates[0]?.threadId || null,
      candidateTurnId: lockedPlan.candidates[0]?.turnId || null,
      targetAccountId: lockedPlan.target.accountId,
      pending: null,
    });
    writeAutoContinueState(attemptState);

    lease = await acquireHeadlessClientsAfterStoragePreflight(codexHome, lockedPlan.candidates,
      () => acquireExclusiveClients({ autoMode: true }));
    writeAutoContinueState(clearExclusivityBlock(readAutoContinueState()));
    assertAutomaticOwnership();
    await runHeadlessBatch({
      nextPlan: async () => {
        writeAutoContinueState({ status: 'running', phase: 'replanning',
          candidateThreadId: null, candidateTurnId: null });
        await waitForObserverIdleAfterTurn();
        refreshUsageNow();
        assertAutomaticOwnership();
        const decision = autoDecisionSnapshot();
        if (decision.action === 'blocked') throw new Error(decision.reason || 'AUTO_PLAN_BLOCKED');
        if (decision.action !== 'resume') return decision;
        const partitioned = await partitionAutomaticPlan(decision, readAutoContinueState().candidateBlocks);
        lockedPlan = partitioned.plan;
        blockedCandidates = partitioned.blocked;
        writeAutoContinueState({ candidateBlocks: partitioned.candidateBlocks });
        const retired = await retireBlockedCandidates(blockedCandidates,
          partitioned.candidateBlocks, { lockHeld: true });
        const retiredKeys = new Set(retired.map(candidate => candidateKey(candidate.threadId, candidate.turnId)));
        blockedCandidates = blockedCandidates.filter(candidate =>
          !retiredKeys.has(candidateKey(candidate.threadId, candidate.turnId)));
        if (!lockedPlan.candidates.length) return { action: 'waiting',
          reason: 'unavailable-candidates', candidates: [] };
        return lockedPlan;
      },
      switchTarget: async plan => {
        const active = activeAccountState();
        if (active.accountId === plan.target.accountId && active.accountKey === plan.target.accountKey) return false;
        writeAutoContinueState({ phase: 'switching auth', sourceAccountId: active.accountId,
          targetAccountId: plan.target.accountId,
          candidateThreadId: plan.candidates[0].threadId,
          candidateTurnId: plan.candidates[0].turnId });
        switchToTarget(plan.target);
        refreshUsageNow();
        return true;
      },
      runCandidate: async (candidate, plan) => {
        currentCandidate = candidate;
        committed = false;
        writeAutoContinueState({ phase: 'starting continuation',
          candidateThreadId: candidate.threadId, candidateTurnId: candidate.turnId,
          targetAccountId: plan.target.accountId });
        try {
          refreshUsageNow();
          if (!sameHeadlessDecisionPlan(plan, autoDecisionSnapshot(), blockedCandidates)) {
            throw new Error('AUTO_PLAN_CHANGED_BEFORE_RESUME');
          }
          const target = activeAccountState();
          if (target.accountId !== plan.target.accountId || target.accountKey !== plan.target.accountKey) {
            throw new Error('ACTIVE_ACCOUNT_CHANGED');
          }
          assertFreshUsableTarget(target.accountId);
          let persisted;
          try {
            persisted = assertObserverIdle(normalizeState(readJson(eventStatePath, {}), Date.now()), candidate);
          } catch (error) {
            if (error.message === 'CANDIDATE_NO_LONGER_RESUMABLE') {
              throw new Error('AUTO_PLAN_CHANGED_BEFORE_RESUME');
            }
            throw error;
          }
          const storage = await headlessStoragePreflight(codexHome, [persisted]);
          if (!storage.ok) throw new Error('AUTO_PLAN_CHANGED_BEFORE_RESUME');
          const result = await runResume(persisted, target.accountId,
            async (controlledAppServerPid, continuation) => {
              assertAutomaticOwnership(controlledAppServerPid);
              refreshUsageNow();
              if (!sameHeadlessDecisionPlan(plan, autoDecisionSnapshot(), blockedCandidates)) {
                throw new Error('AUTO_PLAN_CHANGED_BEFORE_COMMIT');
              }
              const commitTarget = activeAccountState();
              if (commitTarget.accountId !== target.accountId || commitTarget.accountKey !== target.accountKey) {
                throw new Error('ACTIVE_ACCOUNT_CHANGED_BEFORE_COMMIT');
              }
              let journal = normalizeResumeState(readJson(resumeStatePath, emptyResumeState()));
              journal = markResumeCommitted(journal, persisted, {
                targetAccountId: target.accountId, automatic: true, continuation,
              });
              atomicWriteJson(resumeStatePath, journal);
              committed = true;
              writeAutoContinueState({ phase: 'running' });
            }, { automatic: true });
          const finalTarget = activeAccountState();
          if (finalTarget.accountId !== target.accountId || finalTarget.accountKey !== target.accountKey) {
            throw new Error('ACTIVE_ACCOUNT_CHANGED_AFTER_COMMIT');
          }
          let journal = normalizeResumeState(readJson(resumeStatePath, emptyResumeState()));
          journal = markResumeTerminal(journal, persisted, result);
          atomicWriteJson(resumeStatePath, journal);
          const historyState = readAutoContinueState();
          const withFallbackResult = finishHeadlessFallbackHistory(historyState, persisted, result);
          if (withFallbackResult !== historyState) writeAutoContinueState(withFallbackResult);
          lastTerminalThreadId = persisted.threadId;
          lastTerminalFailedTurnId = persisted.turnId;
          await waitForObserverIdleAfterTurn();
          if (result.status !== 'completed') throw new Error('AUTO_RESUME_TERMINAL_FAILED');
          currentCandidate = null;
          committed = false;
        } catch (error) {
          if (!committed && shouldReplanAutomaticError(error, false)) {
            writeAutoContinueState(recordPrecommitPlanChange(readAutoContinueState(), error.message, {
              threadId: candidate.threadId, failedTurnId: candidate.turnId,
              targetAccountId: plan.target.accountId,
            }));
            currentCandidate = null;
            return 'replan';
          }
          throw error;
        }
      },
      onNoWork: async (plan, completedCount) => {
        const active = activeAccountState();
        writeAutoContinueState({ status: plan.action === 'idle' && completedCount > 0 ? 'completed' : 'waiting',
          phase: null, sourceAccountId: null,
          waitingReason: plan.action === 'idle' ? 'no-candidates' : (plan.reason || 'unavailable-candidates'),
          lastSuccessAtMs: completedCount > 0 ? Date.now() : readAutoContinueState().lastSuccessAtMs,
          errorKind: null, actionRequired: false,
          candidateThreadId: null, candidateTurnId: null,
          targetAccountId: active.accountId, pending: null,
          restoreRetryHalt: false, restoreRetryHaltGeneration: null });
      },
    });
  } catch (error) {
    const precommitPlanChange = shouldReplanAutomaticError(error, committed);
    if (precommitPlanChange) {
      shouldReplan = true;
      writeAutoContinueState(recordPrecommitPlanChange(readAutoContinueState(), error.message, {
        threadId: currentCandidate?.threadId || lockedPlan.candidates[0]?.threadId,
        failedTurnId: currentCandidate?.turnId || lockedPlan.candidates[0]?.turnId,
        targetAccountId: lockedPlan.target?.accountId,
      }));
    } else if (committed && currentCandidate) {
      let journal = normalizeResumeState(readJson(resumeStatePath, emptyResumeState()));
      journal = markResumeFailure(journal, currentCandidate, error?.message || 'AUTO_RESUME_FAILED', {
        committed: true,
        diagnostics: error?.diagnostics || null,
      });
      atomicWriteJson(resumeStatePath, journal);
      const historyState = readAutoContinueState();
      const withFallbackFailure = finishHeadlessFallbackHistory(historyState, currentCandidate, {
        turnId: journal.attempts[candidateKey(currentCandidate.threadId, currentCandidate.turnId)]?.continuationTurnId,
        status: 'failed',
      });
      if (withFallbackFailure !== historyState) writeAutoContinueState(withFallbackFailure);
    }
    const preCommitExclusivity = !committed && error?.message === 'APP_SERVER_EXCLUSIVITY_FAILED';
    const transient = error?.message === 'RESUME_ALREADY_RUNNING';
    if (precommitPlanChange) {
      // The old lock and lease are released before the timer replans.
    } else if (preCommitExclusivity) {
      const blocked = recordExclusivityBlock(readAutoContinueState(), error.diagnostics, {
        threadId: currentCandidate?.threadId || initial.candidates[0]?.threadId || null,
        failedTurnId: currentCandidate?.turnId || initial.candidates[0]?.turnId || null,
        targetAccountId: initial.target?.accountId || null,
      });
      writeAutoContinueState({ ...blocked, lastAttemptAtMs: Date.now() });
      if (blocked.actionRequired) process.exitCode = 1;
    } else {
      writeAutoContinueState({
        status: transient ? 'waiting' : 'blocked',
        waitingReason: transient ? 'resume-already-running' : null,
        lastAttemptAtMs: Date.now(),
        errorKind: transient ? null : error?.message || 'AUTO_RESUME_FAILED',
        diagnostics: error?.diagnostics || null,
        actionRequired: !transient,
        candidateThreadId: currentCandidate?.threadId || initial.candidates[0]?.threadId || null,
        candidateTurnId: currentCandidate?.turnId || initial.candidates[0]?.turnId || null,
        targetAccountId: initial.target?.accountId || null,
        pending: null,
        ...(isDesktopRestoreError(error) ? { desktopRestore: {
          status: 'failed', completedAtMs: Date.now(), errorKind: error.message,
          diagnostics: error.diagnostics || null,
        } } : {}),
      });
      if (!transient) process.exitCode = 1;
    }
  } finally {
    if (lease) {
      try {
        const restored = await restoreClients(lease, { forceRendererAccessibility: true });
        const navigation = headlessPostRestoreNavigationPlan({
          desktopRestore: restored.desktopRestore,
          lastTerminalThreadId,
        });
        writeAutoContinueState({
          desktopRestore: restored.desktopRestore ? {
            status: 'ready',
            completedAtMs: Date.now(),
            ...restored.desktopRestore,
          } : null,
        });
        if (navigation) {
          navigationPhase = true;
          const atspi = new DesktopAtspiController();
          try {
            await runHeadlessPostRestoreNavigation({
              plan: navigation,
              waitForRouteReady: async () => (await waitForDesktopReadiness({
                attempt: async () => desktopCapability(await atspi.request({
                  command: 'route-ready', desktopPid: navigation.desktopPid,
                })),
              })).diagnostics,
              dispatch: url => launchDesktopDeepLinkObserved(url),
              confirm: async () => (await waitForDesktopReadiness({
                attempt: async () => desktopCapability(await atspi.request({
                  command: 'preflight', threadId: navigation.threadId, desktopPid: navigation.desktopPid,
                })),
              })).diagnostics,
              onState: desktopNavigation => writeAutoContinueState({ desktopNavigation: {
                ...desktopNavigation, failedTurnId: lastTerminalFailedTurnId,
              } }),
            });
          } finally {
            await atspi.close();
          }
        }
      } catch (error) {
        if (navigationPhase && readAutoContinueState().desktopRestore?.status === 'ready') {
          const navigationFailure = { desktopNavigation: {
            status: 'failed', threadId: lastTerminalThreadId,
            failedTurnId: lastTerminalFailedTurnId,
            errorKind: error?.message || 'DESKTOP_NAVIGATION_FAILED', completedAtMs: Date.now(),
          } };
          writeAutoContinueState(archiveTerminalDesktopNavigation({
            ...readAutoContinueState(), ...navigationFailure,
          }, normalizeResumeState(readJson(resumeStatePath, emptyResumeState()))));
        } else {
          shouldReplan = false;
          writeAutoContinueState({
          status: 'blocked',
          lastAttemptAtMs: Date.now(),
          errorKind: error?.message || 'AUTO_CLIENT_RESTORE_FAILED',
          actionRequired: true,
          candidateThreadId: currentCandidate?.threadId || null,
          candidateTurnId: currentCandidate?.turnId || null,
          targetAccountId: initial.target?.accountId || null,
          pending: null,
          desktopRestore: {
            status: 'failed',
            completedAtMs: Date.now(),
            errorKind: error?.message || 'AUTO_CLIENT_RESTORE_FAILED',
            diagnostics: error?.diagnostics || null,
          },
          });
          process.exitCode = 1;
        }
      }
    }
    if (lock) releaseLock(lock);
  }
  return shouldReplan ? 'replan' : 'done';
}

function launchDesktopDeepLinkObserved(url) {
  return new Promise((resolve, reject) => {
    const sequence = Date.now();
    const spec = desktopDeepLinkLaunchSpec({
      systemdRunBin, desktopBinary, controllerPid: process.pid, sequence, url,
    });
    const child = spawn(spec.command, spec.args, { stdio: 'ignore' });
    const unit = `codex-desktop-navigation-${process.pid}-${sequence}`;
    let settled = false;
    const timer = setTimeout(() => {
      if (settled) return;
      settled = true;
      child.kill('SIGTERM');
      reject(Object.assign(new Error('DESKTOP_DEEPLINK_HANDOFF_TIMEOUT'), {
        diagnostics: { launcherPid: child.pid, unit },
      }));
    }, 10_000);
    child.once('error', error => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      reject(Object.assign(new Error('DESKTOP_DEEPLINK_LAUNCH_FAILED'), {
        diagnostics: { code: error?.code || null, unit },
      }));
    });
    child.once('exit', (code, signal) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      if (code === 0) resolve({ pid: child.pid, unit });
      else reject(Object.assign(new Error('DESKTOP_DEEPLINK_HANDOFF_FAILED'), {
        diagnostics: { launcherPid: child.pid, unit, code, signal },
      }));
    });
  });
}

function desktopCapability(response) {
  const entries = processEntries();
  const roots = entries.filter(isDesktopRoot).map(entry => entry.pid);
  const desktopTree = new Set(descendants(entries, roots));
  const renderers = entries.filter(entry =>
    desktopTree.has(entry.pid) && entry.args.some(argument => argument === '--type=renderer')
  ).map(entry => entry.pid).sort((left, right) => left - right);
  if (roots.length !== 1 || renderers.length === 0) throw new Error('DESKTOP_PROCESS_IDENTITY_UNVERIFIED');
  const packageResult = spawnSync('dpkg-query', ['-W', '-f=${Version}', 'chatgpt'], {
    encoding: 'utf8', timeout: 5_000,
  });
  if (packageResult.error || packageResult.status !== 0 || !packageResult.stdout.trim()) {
    throw new Error('DESKTOP_VERSION_UNVERIFIED');
  }
  return {
    verified: response?.verified === true,
    desktopIdentity: {
      ...(response?.desktopIdentity || {}),
      packageVersion: packageResult.stdout.trim(),
      rootPid: roots[0],
    },
    rendererIdentity: {
      ...(response?.rendererIdentity || {}),
      rendererPids: renderers,
    },
    atspiIdentity: response?.atspiIdentity || null,
  };
}

async function automaticMain() {
  const navigationState = readAutoContinueState();
  const archivedNavigation = archiveTerminalDesktopNavigation(navigationState,
    normalizeResumeState(readJson(resumeStatePath, emptyResumeState())));
  if (archivedNavigation.desktopNavigation !== navigationState.desktopNavigation) {
    writeAutoContinueState(archivedNavigation);
  }
  const diagnosticState = readAutoContinueState();
  if (diagnosticState.desktopRestore?.status === 'failed' &&
      diagnosticState.desktopRestore.errorKind !== 'DESKTOP_ROOT_AMBIGUOUS') {
    const roots = desktopRootIdentities();
    if (roots.length === 1 && Number.isFinite(roots[0].startTicks) && roots[0].startTicks > 0) {
      await sleep(1_000);
      const verified = desktopRootIdentities();
      if (verified.length === 1 && verified[0].pid === roots[0].pid &&
          verified[0].startTicks === roots[0].startTicks) {
        writeAutoContinueState({ desktopRestore: { status: 'ready',
          desktopPid: roots[0].pid, desktopStartTicks: roots[0].startTicks,
          desktopCgroup: roots[0].cgroup, completedAtMs: Date.now() } });
      }
    }
  }
  if (readAutoContinueState().exclusivityBlock && appServerExclusivityReport(processEntries(), {
    ignoredPids: [process.pid],
  }).exclusive) writeAutoContinueState(clearExclusivityBlock(readAutoContinueState()));
  for (let attempt = 0; attempt < 3; attempt += 1) {
    const result = await automaticHeadlessMain();
    if (result !== 'replan') return result;
    refreshUsageNow();
  }
  writeAutoContinueState({ status: 'waiting', waitingReason: 'plan-changing',
    errorKind: null, actionRequired: false, pending: null });
  return 'waiting';
}

async function main() {
  if (process.argv.includes('--restore-watchdog')) return watchdogMode();
  if (process.argv.includes('--auto')) {
    const heartbeat = setInterval(() => writeAutoContinueState({}), 15_000);
    try { return await automaticMain(); } finally { clearInterval(heartbeat); }
  }
  if (process.argv[2] === '--reactivate-retired') {
    const threadId = process.argv[3];
    const turnId = process.argv[4];
    if (!threadId || !turnId || process.argv.length !== 5) throw new Error('EXACT_CANDIDATE_IDS_REQUIRED');
    const lock = acquireLock();
    try {
      const eventState = normalizeState(readJson(eventStatePath, {}), Date.now());
      if (!observerHealth(eventState, Date.now()).healthy) throw new Error('TURN_OBSERVER_UNVERIFIED');
      const candidate = eventState.interruptedTurns?.[candidateKey(threadId, turnId)];
      if (!candidate) throw new Error('CANDIDATE_NOT_FOUND');
      const draftJournal = readDraftJournal();
      if (draftJournal.unverified === true) throw new Error('MANUAL_DRAFT_JOURNAL_UNVERIFIED');
      const storage = await headlessStoragePreflight(codexHome, [candidate]);
      let raw;
      try { raw = JSON.parse(fs.readFileSync(resumeStatePath, 'utf8')); }
      catch { throw new Error('RESUME_JOURNAL_UNVERIFIED'); }
      if (raw.version !== RESUME_STATE_VERSION || !raw.attempts || typeof raw.attempts !== 'object') {
        throw new Error('RESUME_JOURNAL_UNVERIFIED');
      }
      const journal = normalizeResumeState(raw);
      atomicWriteJson(resumeStatePath,
        reactivateRetired(journal, candidate, eventState, draftJournal, storage));
      process.stdout.write(`Reactivated ${threadId} ${turnId}; AUTO may now consider this candidate.\n`);
    } finally { releaseLock(); }
    return;
  }
  const eventState = normalizeState(readJson(eventStatePath, {}), Date.now());
  const resumeState = normalizeResumeState(readJson(resumeStatePath, emptyResumeState()));
  if (process.argv.includes('--list-retired')) {
    for (const entry of resumeState.retirementHistory) {
      process.stdout.write(`${entry.threadId}\t${entry.turnId}\t${entry.reason}\t${new Date(entry.retiredAtMs).toISOString()}\n`);
    }
    return;
  }
  const candidates = pendingInterruptedTurns(eventState, resumeState);
  if (process.argv.includes('--list')) {
    for (const candidate of candidates) {
      process.stdout.write(`${candidate.threadId}\t${candidate.turnId}\t${candidate.accountId || '-'}\n`);
    }
    return;
  }
  const threadId = process.argv[2];
  const turnId = process.argv[3];
  const candidate = candidates.find(item => item.threadId === threadId && item.turnId === turnId);
  if (!candidate) throw new Error('CANDIDATE_NOT_FOUND');
  const lock = acquireLock();
  let lease = null;
  let committed = false;
  try {
    const freshEventState = normalizeState(readJson(eventStatePath, {}), Date.now());
    const persisted = assertObserverIdle(freshEventState, candidate);
    const target = activeAccountState();
    if (target.accountId === persisted.accountId) throw new Error('SWITCH_TO_DIFFERENT_ACCOUNT_REQUIRED');
    assertFreshUsableTarget(target.accountId);
    process.stdout.write(`Fortsätter tråd …${threadId.slice(-8)} med det aktiva kontot. Desktop och VS Code Codex pausas tillfälligt.\n`);
    lease = await acquireExclusiveClients();
    const revalidatedEventState = normalizeState(readJson(eventStatePath, {}), Date.now());
    assertObserverIdle(revalidatedEventState, persisted);
    const revalidatedTarget = activeAccountState();
    if (revalidatedTarget.accountId !== target.accountId) throw new Error('ACTIVE_ACCOUNT_CHANGED');
    assertFreshUsableTarget(target.accountId);

    const result = await runResume(persisted, target.accountId, async (_controlledAppServerPid, continuation) => {
      let journal = normalizeResumeState(readJson(resumeStatePath, emptyResumeState()));
      journal = markResumeCommitted(journal, persisted, {
        targetAccountId: target.accountId,
        continuation,
      });
      atomicWriteJson(resumeStatePath, journal);
      committed = true;
    });
    const finalTarget = activeAccountState();
    if (finalTarget.accountId !== target.accountId || finalTarget.accountKey !== target.accountKey) {
      throw new Error('ACTIVE_ACCOUNT_CHANGED_AFTER_COMMIT');
    }
    let journal = normalizeResumeState(readJson(resumeStatePath, emptyResumeState()));
    journal = markResumeTerminal(journal, persisted, result);
    atomicWriteJson(resumeStatePath, journal);
    process.stdout.write(`Fortsättningsturnen avslutades med status ${result.status}. Klienterna återställs.\n`);
  } catch (error) {
    let journal = normalizeResumeState(readJson(resumeStatePath, emptyResumeState()));
    journal = markResumeFailure(journal, candidate, error?.message || 'MANUAL_RESUME_FAILED', {
      committed,
      diagnostics: error?.diagnostics || null,
    });
    atomicWriteJson(resumeStatePath, journal);
    const details = error?.diagnostics?.blockers?.length
      ? ` (${blockerSummary(error.diagnostics.blockers)})`
      : '';
    process.stderr.write(`MANUAL_REQUIRED: ${error?.message || 'MANUAL_RESUME_FAILED'}${details}\n`);
    process.exitCode = 1;
  } finally {
    if (lease) await restoreClients(lease);
    releaseLock(lock);
  }
}

main().catch(error => {
  process.stderr.write(`MANUAL_REQUIRED: ${error?.message || 'MANUAL_RESUME_FAILED'}\n`);
  process.exitCode = 1;
});

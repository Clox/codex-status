#!/usr/bin/env node

'use strict';

const fs = require('node:fs');
const os = require('node:os');
const path = require('path');
const {
  AUTO_MODE_ORDER,
  CURRENT_VERSION,
  defaultStatusPreferencesPath,
  readStatusPreferences,
  writeStatusPreferences,
} = require(path.join(__dirname, '..', 'lib', 'codex-status-preferences'));
const { ensureAutoTimerRunning } = require(path.join(__dirname, '..', 'lib', 'codex-auto-scheduler'));
const {
  cancelPendingAction,
  emptyAutoContinueState,
  normalizeAutoContinueState,
  migrateLegacyDesktopAutoState,
  resetAutoContinueForToggle,
  writeAutoContinueStateFile,
} = require(path.join(__dirname, '..', 'lib', 'codex-auto-continue'));

const statePath = process.env.CODEX_STATUS_PREFERENCES || defaultStatusPreferencesPath();
const cacheHome = process.env.XDG_CACHE_HOME || path.join(process.env.HOME || os.homedir(), '.cache');
const autoStatePath = process.env.CODEX_AUTO_CONTINUE_STATE || path.join(
  cacheHome, 'codex-account-switcher', 'auto-continue.json'
);
const operationLockPath = process.env.CODEX_OPERATION_LOCK_DIR || path.join(
  path.dirname(autoStatePath), 'exclusive-codex-operation.lock'
);
const command = process.argv[2] || 'show';

function withOperationLock(action) {
  fs.mkdirSync(path.dirname(operationLockPath), { recursive: true, mode: 0o700 });
  try {
    fs.mkdirSync(operationLockPath, { mode: 0o700 });
  } catch (error) {
    if (error?.code !== 'EEXIST') throw error;
    let owner;
    let stale = false;
    try { owner = Number(fs.readFileSync(path.join(operationLockPath, 'owner'), 'utf8').trim()); } catch {}
    if (Number.isInteger(owner) && owner > 0) {
      try { process.kill(owner, 0); } catch (failure) {
        if (failure?.code === 'EPERM') throw new Error('AUTO_MODE_CHANGE_BUSY');
        if (failure?.code !== 'ESRCH') throw failure;
        stale = true;
      }
    }
    if (!stale) throw new Error('AUTO_MODE_CHANGE_BUSY');
    try { fs.unlinkSync(path.join(operationLockPath, 'owner')); } catch {}
    fs.rmdirSync(operationLockPath);
    fs.mkdirSync(operationLockPath, { mode: 0o700 });
  }
  fs.writeFileSync(path.join(operationLockPath, 'owner'), `${process.pid}\n`, { mode: 0o600 });
  try { return action(); } finally {
    try { fs.unlinkSync(path.join(operationLockPath, 'owner')); } catch {}
    fs.rmdirSync(operationLockPath);
  }
}

function readAutoState() {
  try {
    return normalizeAutoContinueState(JSON.parse(fs.readFileSync(autoStatePath, 'utf8')));
  } catch (error) {
    if (error?.code === 'ENOENT') return emptyAutoContinueState();
    throw new Error('AUTO_CONTINUE_STATE_INVALID');
  }
}

try {
  let preferences;
  if (command === 'show') {
    preferences = readStatusPreferences(statePath);
  } else if (command === 'migrate') {
    preferences = withOperationLock(() => {
      let rawPreferences;
      try { rawPreferences = JSON.parse(fs.readFileSync(statePath, 'utf8')); }
      catch (error) { if (error?.code !== 'ENOENT') throw error; }
      const migrated = readStatusPreferences(statePath);
      if (migrated.autoMode !== 'OFF') ensureAutoTimerRunning();
      if (rawPreferences?.autoMode === 'DESKTOP') {
        writeAutoContinueStateFile(autoStatePath,
          migrateLegacyDesktopAutoState(readAutoState()));
      }
      return writeStatusPreferences(statePath, migrated);
    });
  } else if (command === 'toggle-auto-continue') {
    preferences = withOperationLock(() => {
      const current = readStatusPreferences(statePath);
      const nextMode = AUTO_MODE_ORDER[(AUTO_MODE_ORDER.indexOf(current.autoMode) + 1) % AUTO_MODE_ORDER.length];
      if (nextMode !== 'OFF') ensureAutoTimerRunning();
      const next = writeStatusPreferences(statePath, { version: CURRENT_VERSION, autoMode: nextMode });
      writeAutoContinueStateFile(
        autoStatePath,
        resetAutoContinueForToggle(readAutoState(), next.autoMode)
      );
      return next;
    });
  } else if (command === 'cancel-auto-pending') {
    preferences = readStatusPreferences(statePath);
    const result = cancelPendingAction(readAutoState());
    if (result.canceled) writeAutoContinueStateFile(autoStatePath, result.state);
    fs.writeSync(1, `${result.canceled ? 'canceled' : 'none'}\n`);
    process.exit(0);
  } else {
    throw new Error('USAGE: codex-status-preferences [show|migrate|toggle-auto-continue|cancel-auto-pending]');
  }
  process.stdout.write(`${preferences.autoMode.toLocaleLowerCase('en-US')}\n`);
} catch (error) {
  process.stderr.write(`${error?.message || 'STATUS_PREFERENCES_FAILED'}\n`);
  process.exitCode = 1;
}

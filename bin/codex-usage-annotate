#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const {
  activationHoldForAccount,
  defaultActivationHoldsPath,
  readActivationHolds,
} = require(path.join(__dirname, '..', 'lib', 'codex-activation-hold'));
const {
  rankAccounts,
  recommendAccount,
  scoreAccount,
} = require(path.join(__dirname, '..', 'lib', 'codex-account-ranking'));
const {
  formatResetValue,
} = require(path.join(__dirname, '..', 'lib', 'codex-reset-credits'));
const {
  assessCacheHealth,
} = require(path.join(__dirname, '..', 'lib', 'codex-usage-cache'));
const {
  REPAIRABLE_ERROR_KINDS,
} = require(path.join(__dirname, '..', 'lib', 'codex-auth-repair'));
const {
  accountIdentifiers,
  colorAccountTableRow,
  normalizeAccountRow,
  recommendationLines,
  renderAccountTableRow,
} = require(path.join(__dirname, '..', 'lib', 'codex-status-render'));
const {
  activationWorkerHealth,
} = require(path.join(__dirname, '..', 'lib', 'codex-five-hour-worker'));
const {
  tableCell,
  activationObservationHoldLine,
  activationProblemLine,
  activationWorkerProblem,
  usageProblemLine,
  weeklyUrgencyLabel,
} = require(path.join(__dirname, '..', 'lib', 'codex-usage-format'));

const registryPath = path.join(process.env.CODEX_HOME || path.join(process.env.HOME, '.codex'), 'accounts', 'registry.json');
const resetCreditsCachePath = process.env.RESET_CREDITS_CACHE || path.join(
  process.env.XDG_CACHE_HOME || path.join(process.env.HOME, '.cache'),
  'codex-account-switcher',
  'reset-credits.json'
);
const usageCachePath = process.env.USAGE_CACHE || path.join(
  process.env.XDG_CACHE_HOME || path.join(process.env.HOME, '.cache'),
  'codex-account-switcher',
  'usage.json'
);
const activationStatePath = process.env.FIVE_HOUR_ACTIVATION_STATE || path.join(
  process.env.XDG_CACHE_HOME || path.join(process.env.HOME, '.cache'),
  'codex-account-switcher',
  'five-hour-activation.json'
);
const input = fs.readFileSync(0, 'utf8').replace(/\r/g, '');
const mappingOnly = process.argv.includes('--key-map');
const rankingEnabled = mappingOnly || process.env.CODEX_STATUS_RANKING === '1';
const pendingSourceCandidate = process.env.CODEX_PENDING_SOURCE_ROW || process.env.CODEX_PENDING_ROW || '';
const pendingSourceRow = /^(1|2|3)$/.test(pendingSourceCandidate)
  ? pendingSourceCandidate
  : null;
const nowMs = Number.isFinite(Number(process.env.CODEX_STATUS_NOW_MS))
  ? Number(process.env.CODEX_STATUS_NOW_MS)
  : Date.now();

function plain(value) {
  return value.replace(/\x1b\[[0-9;?]*[ -/]*[@-~]/g, '');
}

function formatRemaining(epochSeconds) {
  if (!Number.isFinite(epochSeconds)) return '?';
  const minutes = Math.max(0, Math.ceil((epochSeconds * 1000 - nowMs) / 60000));
  const hours = Math.floor(minutes / 60);
  return `${hours}:${String(minutes % 60).padStart(2, '0')}`;
}

function configuredAccountNumber(account) {
  if (!account) return '-';
  const identifiers = accountIdentifiers(account);
  for (const number of ['1', '2', '3']) {
    const selector = process.env[`ACCOUNT_${number}`]?.toLocaleLowerCase('sv-SE');
    if (selector && identifiers.some(identifier => identifier.includes(selector) || selector.includes(identifier))) {
      return number;
    }
  }
  return '-';
}

let accounts = [];
let resetCreditsByAccountId = {};
let serverUsageByAccountId = {};
let usageCacheState = {};
let activationState = {};
let activationHolds = { version: 1, accounts: {} };
let activationHoldsError = null;
try {
  const registry = JSON.parse(fs.readFileSync(registryPath, 'utf8'));
  accounts = Array.isArray(registry.accounts)
    ? registry.accounts
    : Object.values(registry.accounts || {});
} catch {
  if (mappingOnly) process.exit(1);
  process.stdout.write(input);
  process.exit(0);
}

try {
  resetCreditsByAccountId = JSON.parse(fs.readFileSync(resetCreditsCachePath, 'utf8')).accounts || {};
} catch {}

try {
  usageCacheState = JSON.parse(fs.readFileSync(usageCachePath, 'utf8'));
  serverUsageByAccountId = usageCacheState.accounts || {};
} catch {}
const cacheHealth = assessCacheHealth(usageCacheState, nowMs);
try {
  activationState = JSON.parse(fs.readFileSync(activationStatePath, 'utf8'));
} catch {}
try {
  activationHolds = readActivationHolds(defaultActivationHoldsPath());
} catch (error) {
  activationHoldsError = error?.message || 'ACTIVATION_HOLDS_INVALID';
}
const fiveHourWorkerHealth = activationWorkerHealth(activationState, nowMs);

const lines = input.split('\n');
const visibleLines = lines.map(plain);
const headerIndex = visibleLines.findIndex(line =>
  line.includes('ACCOUNT') && line.includes('5H USAGE') && line.includes('WEEKLY USAGE')
);

if (headerIndex < 0) {
  if (mappingOnly) process.exit(1);
  process.stdout.write(input);
  process.exit(0);
}

const header = visibleLines[headerIndex];

const columns = {
  account: header.indexOf('ACCOUNT'),
  plan: header.indexOf('PLAN'),
  fiveHour: header.indexOf('5H USAGE'),
  weekly: header.indexOf('WEEKLY USAGE'),
  activity: header.indexOf('LAST ACTIVITY'),
};

function fit(value, width) {
  if (value.length >= width) return value.slice(0, width);
  return value.padEnd(width, ' ');
}

const sourceRows = [];

for (const [lineIndex, visible] of visibleLines.entries()) {
  const rowMatch = visible.match(/^\s*\*?\s*0?(\d+)\s+/);
  if (!rowMatch || Object.values(columns).some(position => position < 0)) continue;

  sourceRows.push(normalizeAccountRow({
    visible,
    lineIndex,
    rowMatch,
    columns,
    accounts,
    serverUsageByAccountId,
    resetCreditsByAccountId,
    nowMs,
    cacheHealth,
    configuredAccountNumber,
    formatRemaining,
  }));
}

const rankedRows = rankingEnabled
  ? rankAccounts(sourceRows, { nowMs })
  : sourceRows.map((row, index) => ({
      ...scoreAccount(row, { nowMs }),
      rank: index + 1,
    }));

if (mappingOnly) {
  process.stdout.write(rankedRows
    .map(row => `${row.rank}\t${row.sourceRow}\t${row.active ? 'active' : '-'}\t${row.accountNumber}`)
    .join('\n'));
  process.exit(0);
}

const recommendation = rankingEnabled ? recommendAccount(rankedRows) : null;
const rankedByLineIndex = new Map();
const rowLineIndexes = sourceRows.map(row => row.lineIndex).sort((left, right) => left - right);
for (const [index, lineIndex] of rowLineIndexes.entries()) {
  rankedByLineIndex.set(lineIndex, rankedRows[index]);
}

const fiveHourWidth = Math.max(
  '5H USAGE'.length + 1,
  ...rankedRows.map(row => row.fiveHour.length + 1)
);
const resetValues = rankedRows.map(row => formatResetValue(row.resetCredits, nowMs));
const resetWidth = Math.max(
  'RESETS'.length + 1,
  ...resetValues.map(value => value.length + 1)
);
const weeklyUrgencyWidth = Math.max(
  'W%/H'.length + 2,
  ...rankedRows.map(row => weeklyUrgencyLabel(row).length + 1)
);
const weeklyWidth = Math.max(
  'WEEKLY USAGE'.length + 1,
  ...rankedRows.map(row => row.weekly.length + 1)
);
const tableSeparatorOverhead = 5;
const widthBeforeActivity = columns.activity - columns.account;
const accountWidth = Math.max(
  'ACCOUNT'.length + 1,
  widthBeforeActivity - resetWidth - fiveHourWidth - weeklyWidth - weeklyUrgencyWidth - tableSeparatorOverhead
);

const renderedHeader = header.slice(0, columns.account) +
  tableCell('ACCOUNT', accountWidth) +
  tableCell('RESETS', resetWidth) +
  tableCell('5H USAGE', fiveHourWidth) +
  tableCell('WEEKLY USAGE', weeklyWidth) +
  tableCell('W%/H', weeklyUrgencyWidth) +
  header.slice(columns.activity).trimEnd();

function tableDivider(length) {
  const divider = Array.from({ length }, () => '─');
  for (const [index, character] of Array.from(renderedHeader).entries()) {
    if (character === '│' && index < divider.length) divider[index] = '┼';
  }
  return divider.join('');
}

const output = lines.map((line, lineIndex) => {
  if (lineIndex === headerIndex) {
    return renderedHeader;
  }

  if (lineIndex === headerIndex + 1 && /^\s*-+\s*$/.test(visibleLines[lineIndex])) {
    return tableDivider(Math.max(plain(line).trimEnd().length, renderedHeader.length));
  }

  const row = rankedByLineIndex.get(lineIndex);
  if (!row) return line;

  const pending = pendingSourceRow === row.sourceRow;
  const color = row.usageQuality === 'unverified'
    ? '\x1b[1;31m'
    : row.active
      ? '\x1b[0;32m'
      : pending
        ? '\x1b[0;33m'
        : '\x1b[0;2m';
  const rendered = renderAccountTableRow(row, {
    columns,
    accountWidth,
    resetWidth,
    fiveHourWidth,
    weeklyWidth,
    weeklyUrgencyWidth,
    nowMs,
  });
  return colorAccountTableRow(rendered, color);
});

const renderedRecommendationLines = recommendationLines(recommendation);

const usageQualityNotes = [];
if (rankedRows.some(row => row.usageQuality === 'stale')) {
  usageQualityNotes.push('~ = tillfälligt stale serverdata (3–15 minuter)');
}
if (rankedRows.some(row => row.usageQuality === 'unverified')) {
  usageQualityNotes.push('AUTH/ERROR = historiska värden, ej verifierat beslutsunderlag');
}
const usageQualityLine = usageQualityNotes.length > 0
  ? `\x1b[2m${usageQualityNotes.join('; ')}.\x1b[0m`
  : null;
const problems = [
  activationWorkerProblem(fiveHourWorkerHealth),
  activationHoldsError
    ? `ACTIVATION HOLD CONFIG ERROR / ACTION REQUIRED: ${activationHoldsError}; activation-workern avbryter säkert tills konfigurationen rättats.`
    : null,
  ...rankedRows.flatMap(row => [
    usageProblemLine(row),
    activationProblemLine(row, activationState.accounts?.[row.accountId]),
  ]),
].filter(Boolean);
const repairableProblemCount = rankedRows.filter(row =>
  row.usageQuality === 'unverified' && REPAIRABLE_ERROR_KINDS.has(row.errorKind)
).length;
const problemSection = problems.length > 0
  ? `\n\x1b[1;31mACCOUNT PROBLEMS:\x1b[0m\n${problems.map(line => `\x1b[31m${line}\x1b[0m`).join('\n')}${repairableProblemCount > 0 ? '\n\x1b[1;33mPress [R] to repair authentication\x1b[0m' : ''}`
  : '';
const information = rankedRows.map(row => activationObservationHoldLine(
  row,
  activationHoldForAccount(activationHolds, row.accountId)
)).filter(Boolean);
const informationSection = information.length > 0
  ? `\n\x1b[1;36mACCOUNT INFO:\x1b[0m\n${information.map(line => `\x1b[36m${line}\x1b[0m`).join('\n')}`
  : '';
const footerParts = [renderedRecommendationLines.join('\n')];
if (usageQualityLine) footerParts.push(usageQualityLine);
const footer = `${footerParts.join('\n')}${informationSection}${problemSection}`;
process.stdout.write(`${output.join('\n').trimEnd()}\n\n${footer}`);

#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const {
  rankAccounts,
  recommendAccount,
  scoreAccount,
} = require(path.join(__dirname, '..', 'lib', 'codex-account-ranking'));
const {
  formatResetValue,
} = require(path.join(__dirname, '..', 'lib', 'codex-reset-credits'));
const {
  usageBlock,
  weeklyUrgencyLabel,
} = require(path.join(__dirname, '..', 'lib', 'codex-usage-format'));

const registryPath = path.join(process.env.CODEX_HOME || path.join(process.env.HOME, '.codex'), 'accounts', 'registry.json');
const resetCreditsCachePath = process.env.RESET_CREDITS_CACHE || path.join(
  process.env.XDG_CACHE_HOME || path.join(process.env.HOME, '.cache'),
  'codex-account-switcher',
  'reset-credits.json'
);
const input = fs.readFileSync(0, 'utf8').replace(/\r/g, '');
const mappingOnly = process.argv.includes('--key-map');
const rankingEnabled = mappingOnly || process.env.CODEX_STATUS_RANKING === '1';
const pendingSourceCandidate = process.env.CODEX_PENDING_SOURCE_ROW || process.env.CODEX_PENDING_ROW || '';
const pendingSourceRow = /^(1|2|3)$/.test(pendingSourceCandidate)
  ? pendingSourceCandidate
  : null;
const nowMs = Number.isFinite(Number(process.env.CODEX_STATUS_NOW_MS))
  ? Number(process.env.CODEX_STATUS_NOW_MS)
  : Date.now();

function plain(value) {
  return value.replace(/\x1b\[[0-9;?]*[ -/]*[@-~]/g, '');
}

function formatRemaining(epochSeconds) {
  if (!Number.isFinite(epochSeconds)) return '?';
  const minutes = Math.max(0, Math.ceil((epochSeconds * 1000 - nowMs) / 60000));
  const hours = Math.floor(minutes / 60);
  return `${hours}:${String(minutes % 60).padStart(2, '0')}`;
}

function accountIdentifiers(account) {
  return [account.email, account.account_name, account.alias]
    .filter(value => typeof value === 'string' && value.length > 0)
    .map(value => value.toLocaleLowerCase('sv-SE'));
}

let accounts = [];
let resetCreditsByAccountId = {};
try {
  const registry = JSON.parse(fs.readFileSync(registryPath, 'utf8'));
  accounts = Array.isArray(registry.accounts)
    ? registry.accounts
    : Object.values(registry.accounts || {});
} catch {
  if (mappingOnly) process.exit(1);
  process.stdout.write(input);
  process.exit(0);
}

try {
  resetCreditsByAccountId = JSON.parse(fs.readFileSync(resetCreditsCachePath, 'utf8')).accounts || {};
} catch {}

const lines = input.split('\n');
const visibleLines = lines.map(plain);
const headerIndex = visibleLines.findIndex(line =>
  line.includes('ACCOUNT') && line.includes('5H USAGE') && line.includes('WEEKLY USAGE')
);

if (headerIndex < 0) {
  if (mappingOnly) process.exit(1);
  process.stdout.write(input);
  process.exit(0);
}

const header = visibleLines[headerIndex];

const columns = {
  account: header.indexOf('ACCOUNT'),
  plan: header.indexOf('PLAN'),
  fiveHour: header.indexOf('5H USAGE'),
  weekly: header.indexOf('WEEKLY USAGE'),
  activity: header.indexOf('LAST ACTIVITY'),
};

function fit(value, width) {
  if (value.length >= width) return value.slice(0, width);
  return value.padEnd(width, ' ');
}

const sourceRows = [];

for (const [lineIndex, visible] of visibleLines.entries()) {
  const rowMatch = visible.match(/^\s*\*?\s*0?(\d+)\s+/);
  if (!rowMatch || Object.values(columns).some(position => position < 0)) continue;

  const shown = visible
    .slice(columns.account, columns.plan)
    .trim()
    .toLocaleLowerCase('sv-SE')
    .replace(/\.+$/, '');
  const account = accounts.find(candidate =>
    accountIdentifiers(candidate).some(identifier => identifier === shown || identifier.startsWith(shown))
  );
  if (!account) continue;

  const usage = account.last_usage || {};
  const fivePercentMatch = visible.slice(columns.fiveHour, columns.weekly).match(/\d+/);
  const weeklyPercentMatch = visible.slice(columns.weekly, columns.activity).match(/\d+/);
  if (!fivePercentMatch || !weeklyPercentMatch) continue;
  const fiveHourRemaining = Number(fivePercentMatch[0]);
  const weeklyRemaining = Number(weeklyPercentMatch[0]);
  const fivePercent = `${fiveHourRemaining}% ${usageBlock(fiveHourRemaining)}`;
  const weeklyPercent = `${weeklyRemaining}% ${usageBlock(weeklyRemaining)}`;
  const fiveHour = `${fivePercent} (${formatRemaining(usage.primary?.resets_at)})`;
  const weekly = `${weeklyPercent} (${formatRemaining(usage.secondary?.resets_at)})`;
  sourceRows.push({
    sourceRow: rowMatch[1],
    lineIndex,
    label: visible.slice(columns.account, columns.plan).trim(),
    prefix: visible.slice(0, columns.fiveHour),
    resetCredits: resetCreditsByAccountId[account.chatgpt_account_id] || null,
    activity: visible.slice(columns.activity).trimEnd(),
    fiveHour,
    weekly,
    fiveHourRemaining,
    fiveHourResetAt: usage.primary?.resets_at,
    weeklyRemaining,
    weeklyResetAt: usage.secondary?.resets_at,
    active: /^\s*\*/.test(visible),
  });
}

const rankedRows = rankingEnabled
  ? rankAccounts(sourceRows, { nowMs })
  : sourceRows.map((row, index) => ({
      ...scoreAccount(row, { nowMs }),
      rank: index + 1,
    }));

if (mappingOnly) {
  process.stdout.write(rankedRows
    .map(row => `${row.rank}\t${row.sourceRow}\t${row.active ? 'active' : '-'}`)
    .join('\n'));
  process.exit(0);
}

const recommendation = rankingEnabled ? recommendAccount(rankedRows) : null;
const rankedByLineIndex = new Map();
const rowLineIndexes = sourceRows.map(row => row.lineIndex).sort((left, right) => left - right);
for (const [index, lineIndex] of rowLineIndexes.entries()) {
  rankedByLineIndex.set(lineIndex, rankedRows[index]);
}

const fiveHourWidth = Math.max(
  columns.weekly - columns.fiveHour,
  ...rankedRows.map(row => row.fiveHour.length + 1)
);
const resetValues = rankedRows.map(row => formatResetValue(row.resetCredits, nowMs));
const resetWidth = Math.max(
  'RESETS'.length + 1,
  ...resetValues.map(value => value.length + 1)
);
const accountAndPlanWidth = columns.fiveHour - columns.account;
const accountWidth = Math.max(
  'ACCOUNT'.length + 1,
  accountAndPlanWidth - resetWidth
);

const weeklyUrgencyWidth = Math.max(
  'W%/H'.length + 2,
  ...rankedRows.map(row => weeklyUrgencyLabel(row).length + 1)
);
const weeklyWidth = Math.max(
  columns.activity - columns.weekly - weeklyUrgencyWidth,
  'WEEKLY USAGE'.length + 1,
  ...rankedRows.map(row => row.weekly.length + 1)
);

function prefixForRank(row) {
  const markerAndRank = `${row.active ? '*' : ' '} ${String(row.rank).padStart(2, '0')}`;
  const rankedPrefix = row.prefix.replace(/^\s*\*?\s*0?\d+/, markerAndRank);
  return rankedPrefix.slice(0, columns.account) +
    fit(row.label, accountWidth) +
    fit(formatResetValue(row.resetCredits, nowMs), resetWidth);
}

const output = lines.map((line, lineIndex) => {
  if (lineIndex === headerIndex) {
    return header.slice(0, columns.account) +
      fit('ACCOUNT', accountWidth) +
      fit('RESETS', resetWidth) +
      fit('5H USAGE', fiveHourWidth) +
      fit('WEEKLY USAGE', weeklyWidth) +
      fit('W%/H', weeklyUrgencyWidth) +
      header.slice(columns.activity).trimEnd();
  }

  const row = rankedByLineIndex.get(lineIndex);
  if (!row) return line;

  const pending = pendingSourceRow === row.sourceRow;
  const color = row.active ? '\x1b[0;32m' : pending ? '\x1b[0;33m' : '\x1b[0;2m';
  const rendered =
    prefixForRank(row) +
    fit(row.fiveHour, fiveHourWidth) +
    fit(row.weekly, weeklyWidth) +
    fit(weeklyUrgencyLabel(row), weeklyUrgencyWidth) +
    row.activity +
    (row.active ? '  ACTIVE' : '');
  return `${color}${rendered}\x1b[0m`;
});

if (!recommendation) {
  process.stdout.write(output.join('\n'));
  process.exit(0);
}

const recommendationRank = recommendation.account?.rank;
const recommendationLabel = recommendation.account?.label || 'current account';
const recommendationLines = recommendation.reason === 'needs-activation'
  ? recommendation.action === 'switch'
    ? [
        '\x1b[1mRECOMMENDATION:\x1b[0m',
        `Activate ${recommendationLabel}`,
        'Use it once to start its weekly cycle',
        `Press [${recommendationRank}] to switch`,
      ]
    : [
        '\x1b[1mRECOMMENDATION:\x1b[0m',
        `Use ${recommendationLabel} once`,
        'Start its weekly cycle',
      ]
  : recommendation.action === 'switch'
  ? [
      '\x1b[1mRECOMMENDATION:\x1b[0m',
      `Switch to ${recommendationLabel}`,
      `Press [${recommendationRank}] to switch`,
    ]
  : [
      '\x1b[1mRECOMMENDATION:\x1b[0m',
      `Stay on ${recommendationLabel}`,
    ];

process.stdout.write(`${output.join('\n').trimEnd()}\n\n${recommendationLines.join('\n')}`);

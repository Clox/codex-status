#!/usr/bin/env node
'use strict';

const path = require('node:path');
const { layoutStatusFrame, serializeStatusFrame } =
  require(path.join(__dirname, '..', 'lib', 'codex-status-viewport'));

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', chunk => { input += chunk; });
process.stdin.on('end', () => {
  const result = layoutStatusFrame(input, {
    rows: process.env.CODEX_STATUS_LINES,
    columns: process.env.CODEX_STATUS_COLUMNS,
    offset: process.env.CODEX_STATUS_SCROLL_OFFSET,
    paused: process.env.CODEX_STATUS_PAUSED === '1',
    copyFeedback: process.env.CODEX_STATUS_COPY_FEEDBACK || '',
  });
  process.stdout.write(serializeStatusFrame(result));
});

[Unit]
Description=Observe local Codex turn lifecycle and terminal usage exhaustion
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/codex-turn-observer
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.cache/codex-account-switcher
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
